<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'tutor' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>
  <div class="sub-banner">
    <a href="/tutor" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Hasil Kuesioner Member</h1>
    <p class="sub-banner-desc">Feedback yang tampil di sini berasal dari kuesioner yang diisi member untuk Anda.</p>
  </div>

  <div class="container">
    <div class="at-stats">
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--brand-600)"><i class="fas fa-reply-all"></i></span>
        <div><strong><%= stats.responses %></strong><small>Total respon</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--warning)"><i class="fas fa-star"></i></span>
        <div><strong><%= stats.averageRating || '-' %></strong><small>Rata-rata / 5</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--success)"><i class="fas fa-chart-line"></i></span>
        <div><strong><%= stats.scorePercent %>%</strong><small>Skor performa</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--info)"><i class="fas fa-book-reader"></i></span>
        <div><strong><%= stats.selfStudyYes %></strong><small>Referensi self-study</small></div>
      </div>
    </div>

    <div class="section-card">
      <form method="GET" action="/tutor/questionnaire" class="filter-form">
        <select name="program_id" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Program</option>
          <% programs.forEach(p => { %>
            <option value="<%= p.id %>" <%= String(filters.programId) === String(p.id) ? 'selected' : '' %>><%= p.name %></option>
          <% }) %>
        </select>
        <select name="period" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Periode</option>
          <% periods.forEach(item => { %>
            <option value="<%= item %>" <%= filters.period === item ? 'selected' : '' %>><%= item %></option>
          <% }) %>
        </select>
        <a href="/tutor/questionnaire" class="btn btn-outline">Reset</a>
      </form>
    </div>

    <div class="section-card">
      <div class="presence-header">
        <div>
          <h3>Ringkasan Rating</h3>
          <p>Nilai rata-rata dari seluruh feedback member untuk aspek pengajaran.</p>
        </div>
        <span class="presence-session-count"><i class="fas fa-star"></i> 1-5</span>
      </div>
      <div class="tutor-feedback-grid">
        <% ratingStats.forEach(item => { %>
          <div class="tutor-feedback-score">
            <span><%= item.label %></span>
            <strong><%= item.avg || '-' %></strong>
            <div class="tutor-feedback-bar"><i style="width:<%= item.avg ? Math.min(100, (item.avg / 5) * 100) : 0 %>%"></i></div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="section-card">
      <div class="presence-header">
        <div>
          <h3>Feedback Member</h3>
          <p>Detail komentar, testimoni, dan saran dari member.</p>
        </div>
        <span class="presence-session-count"><i class="fas fa-users"></i> <%= responses.length %> respon</span>
      </div>

      <% if (responses.length === 0) { %>
        <div class="empty-state"><i class="fas fa-inbox"></i><p>Belum ada hasil kuesioner untuk Anda.</p></div>
      <% } else { %>
        <div class="tutor-feedback-list">
          <% responses.forEach(r => { %>
            <% const answers = r.answer_map || {}; %>
            <% const ratings = answers.ratings || {}; %>
            <% const essays = answers.essays || {}; %>
            <% const score = r.max_score > 0 ? Math.round((Number(r.score || 0) / Number(r.max_score)) * 100) : 0; %>
            <details class="tutor-feedback-item">
              <summary>
                <div class="tutor-feedback-member">
                  <% if (r.member_photo) { %>
                    <img src="<%= r.member_photo %>" alt="<%= r.member_name %>">
                  <% } else { %>
                    <span><%= getInitials(r.member_name) %></span>
                  <% } %>
                  <div>
                    <strong><%= r.member_name %></strong>
                    <small><%= r.program_name %><% if (answers.study_period) { %> &middot; <%= answers.study_period %><% } %></small>
                  </div>
                </div>
                <span class="score-badge score-<%= score >= 70 ? 'good' : 'low' %>"><%= score %>%</span>
              </summary>

              <div class="response-answer-list">
                <% teachingRatings.forEach(([key, label]) => { %>
                  <div>
                    <span><%= label %></span>
                    <strong><%= ratings[key] ? `${ratings[key]} - ${ratingLabels[ratings[key]] || ''}` : '-' %></strong>
                  </div>
                <% }) %>
                <% teachingEssays.forEach(([key, label]) => { %>
                  <div>
                    <span><%= label %></span>
                    <strong><%= essays[key] || '-' %></strong>
                  </div>
                <% }) %>
                <div>
                  <span>Referensi self-study</span>
                  <strong><%= answers.self_study_reference || '-' %></strong>
                </div>
                <div>
                  <span>Dikirim</span>
                  <strong><%= r.submitted_at ? formatDate(r.submitted_at) : '-' %></strong>
                </div>
              </div>
            </details>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
