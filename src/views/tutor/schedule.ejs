<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'tutor' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>
  <div class="sub-banner">
    <a href="/tutor" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <div class="sub-banner-titles">
      <h1>Schedule</h1>
      <p class="sub-banner-sub"><%= user.name %></p>
    </div>
    <span class="schedule-managed-note"><i class="fas fa-circle-info"></i> Jadwal dibuat oleh admin</span>
  </div>

  <div class="container">
    <%
      // WhatsApp reminder link toward a member for a given session.
      function waReminderHref(phone, lines) {
        const digits = String(phone || '').replace(/\D/g, '');
        let p = digits;
        if (p.startsWith('0')) p = '62' + p.slice(1);
        else if (p.startsWith('8')) p = '62' + p;
        const text = encodeURIComponent(lines.filter(Boolean).join('\n'));
        return p ? `https://wa.me/${p}?text=${text}` : `https://api.whatsapp.com/send?text=${text}`;
      }
    %>

    <div class="section-card">
      <div class="schedule-toolbar">
        <p class="schedule-filter-note schedule-filter-note--flat"><i class="fas fa-circle-info"></i> Presensi tiap sesi dikelola di halaman <a href="/tutor/presence">Presensi</a>.</p>
        <form method="GET" action="/tutor/schedule" class="schedule-filter schedule-filter-inline">
          <div class="schedule-filter-field">
            <label><i class="far fa-calendar-alt"></i> Periode</label>
            <select name="period" class="form-input" onchange="this.form.submit()">
              <option value="">All</option>
              <% periods.forEach(p => { %>
                <option value="<%= p.value %>" <%= filters.period === p.value ? 'selected' : '' %>><%= p.label %></option>
              <% }) %>
            </select>
          </div>
          <% if (filters.period) { %>
            <a href="/tutor/schedule" class="btn btn-outline schedule-filter-reset"><i class="fas fa-rotate-left"></i> Reset</a>
          <% } %>
        </form>
      </div>

      <%
        // One row per session (table like the reference). Carry the member + group meta.
        const rows = [];
        periodGroups.forEach(g => {
          (g.sessions || []).forEach(s => rows.push({ g, s }));
        });
        rows.sort((a, b) => (String(a.s.date) < String(b.s.date) ? -1 : 1));
      %>

      <% if (rows.length === 0) { %>
        <div class="empty-state"><i class="fas fa-calendar-times"></i><p><%= filters.period ? 'Tidak ada jadwal pada periode ini.' : 'Belum ada jadwal.' %></p></div>
      <% } else { %>
      <div class="jadwal-table-wrap">
        <table class="jadwal-table">
          <thead>
            <tr>
              <th>Nama Lengkap</th>
              <th>Kategori</th>
              <th>Paket</th>
              <th>Program</th>
              <th>Periode</th>
              <th>Durasi</th>
              <th>Jam Belajar</th>
              <th>Tutor</th>
              <th>Zoom Room</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(({ g, s }) => {
                 const isCancelled = s.status === 'cancelled';
                 const past = String(s.date) < new Date().toISOString().slice(0, 10);
                 const attended = s.presence_status === 'present';
                 const memberName = g.member ? g.member.name : 'Tanpa peserta';
            %>
            <tr class="<%= isCancelled ? 'is-cancelled' : (past ? 'is-past' : 'is-upcoming') %>">
              <td data-label="Nama Lengkap" class="jt-name">
                <span><%= memberName %></span>
                <% if (isCancelled) { %>
                  <span class="jt-badge jt-badge-cancel">Dibatalkan</span>
                <% } else if (past) { %>
                  <span class="jt-badge <%= attended ? 'jt-badge-ok' : 'jt-badge-warn' %>"><%= attended ? 'Hadir' : 'Belum Hadir' %></span>
                <% } else { %>
                  <span class="jt-badge jt-badge-next">Akan Datang</span>
                <% } %>
              </td>
              <td data-label="Kategori"><%= g.kategori %></td>
              <td data-label="Paket"><%= g.paket %></td>
              <td data-label="Program"><%= s.program_name || '-' %></td>
              <td data-label="Periode" class="jt-nowrap"><%= formatDate(s.date) %></td>
              <td data-label="Durasi" class="jt-nowrap"><%= g.durasi %></td>
              <td data-label="Jam Belajar" class="jt-nowrap"><%= formatTime(s.start_time) %> - <%= formatTime(s.end_time) %> WIB</td>
              <td data-label="Tutor"><%= user.name %></td>
              <td data-label="Zoom Room"><%= s.location || '-' %></td>
              <td data-label="Aksi" class="jt-actions-cell">
                <div class="jt-actions">
                  <a href="/tutor/presence?schedule_id=<%= g.presence_session_id %>" class="btn btn-primary btn-sm"><i class="fas fa-user-check"></i> Presensi</a>
                  <% if (s.meeting_link) { %>
                    <a href="<%= s.meeting_link %>" target="_blank" rel="noopener" class="btn btn-zoom btn-sm"><i class="fas fa-video"></i> Link ZOOM</a>
                  <% } %>
                  <% if (g.member && g.member.phone) {
                       const waHref = waReminderHref(g.member.phone, [
                         `Halo ${g.member.name}, mengingatkan jadwal kelas kamu 📣`,
                         `📚 ${s.program_name || 'Kelas'}`,
                         `🗓️ ${formatDate(s.date)}`,
                         `⏰ ${formatTime(s.start_time)} - ${formatTime(s.end_time)} WIB`,
                         `👨‍🏫 Tutor: ${user.name}`,
                         s.location ? `📍 ${s.location}` : '',
                         s.meeting_link ? `🔗 Link Zoom: ${s.meeting_link}` : '',
                         `Mohon hadir tepat waktu ya 🙏`
                       ]);
                  %>
                    <a href="<%= waHref %>" target="_blank" rel="noopener" class="btn btn-wa btn-sm"><i class="fab fa-whatsapp"></i> WhatsApp</a>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
