<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'tutor' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/tutor" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Kelola Presensi</h1>
    <p class="sub-banner-desc">Unggah bukti mengajar per member, dan lihat bukti presensi yang masuk.</p>
  </div>

  <div class="container">
    <!-- Upload bukti presensi: tutor menandai kelas untuk seorang member -->
    <div class="section-card" id="riwayat-presensi">
      <h3 class="section-title"><i class="fas fa-camera"></i> Upload Bukti Presensi</h3>
      <form action="/tutor/presence/submit" method="POST" enctype="multipart/form-data" class="modal-form" id="tutorPresenceForm">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Full Name <span class="req">*</span></label>
            <input type="text" class="form-input ff-read-only" value="<%= user.name %>" readonly>
          </div>
          <div class="form-group">
            <label class="form-label">Member <span class="req">*</span></label>
            <select name="member_id" class="form-input" required <%= myMembers.length === 0 ? 'disabled' : '' %>>
              <option value="">- Pilih Member -</option>
              <% myMembers.forEach(m => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
            </select>
            <% if (myMembers.length === 0) { %>
              <small class="field-hint">Belum ada member di kelasmu. Hubungi admin bila jadwal kelasmu belum muncul.</small>
            <% } %>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Program <span class="req">*</span></label>
            <select name="program_id" class="form-input" required>
              <option value="">- Select -</option>
              <% programs.forEach(p => { %><option value="<%= p.id %>" <%= programs.length === 1 ? 'selected' : '' %>><%= p.name %></option><% }) %>
            </select>
            <% if (programs.length === 0) { %>
              <small class="field-hint">Belum ada program yang kamu ajar. Hubungi admin bila kelasmu belum muncul.</small>
            <% } %>
          </div>
          <div class="form-group">
            <label class="form-label">Study Period <span class="req">*</span></label>
            <select name="period_start" class="form-input" required>
              <option value="">- Select -</option>
              <% periods.forEach(p => { %><option value="<%= p.value %>"><%= p.label %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Meeting <span class="req">*</span></label>
          <select name="meeting_number" class="form-input" required>
            <option value="">- Select -</option>
            <% meetings.forEach(m => { %><option value="<%= m %>"><%= m %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Class Screenshot <span class="req">*</span></label>
          <input type="file" name="class_screenshot" class="form-input" accept="image/*" required>
          <p class="field-hint">Unggah screenshot kelas (JPG/PNG/WEBP, maks. 5MB) sebagai bukti mengajar.</p>
        </div>
        <button type="submit" class="btn btn-primary btn-full"><i class="fas fa-paper-plane"></i> Submit</button>
      </form>
    </div>

    <!-- Riwayat presensi tutor sendiri (data lama) -->
    <% if (myPresences.length > 0) { %>
    <div class="section-card">
      <div class="presence-history-head">
        <h3 class="section-title"><i class="fas fa-clock-rotate-left"></i> Riwayat Presensi Saya</h3>
        <span class="presence-session-count"><i class="fas fa-list-check"></i> <%= myPresences.length %> presensi</span>
      </div>
      <div class="table-wrapper">
        <table class="data-table presence-history-table">
          <thead>
            <tr><th>Dikirim</th><th>Program &amp; Periode</th><th>Pertemuan</th><th>Bukti</th></tr>
          </thead>
          <tbody>
            <% myPresences.forEach(s => { %>
            <tr>
              <td data-label="Dikirim">
                <div class="ph-date">
                  <strong><%= formatDate(s.created_at) %></strong>
                  <small><i class="far fa-clock"></i> <%= new Date(s.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</small>
                </div>
              </td>
              <td data-label="Program">
                <div class="ph-program">
                  <strong><%= s.program_name || '-' %></strong>
                  <small><i class="far fa-calendar"></i> <%= s.period_label %></small>
                </div>
              </td>
              <td data-label="Pertemuan"><span class="ph-meeting"><i class="fas fa-hashtag"></i> Pertemuan <b><%= s.meeting_number %></b></span></td>
              <td data-label="Bukti">
                <% if (s.screenshot) { %>
                  <a href="<%= s.screenshot %>" target="_blank" rel="noopener" class="ph-proof">
                    <img src="<%= s.screenshot %>" alt="bukti">
                    <span><i class="fas fa-up-right-from-square"></i> Lihat</span>
                  </a>
                <% } else { %>
                  <span class="ph-noproof"><i class="fas fa-image"></i> Tanpa bukti</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <div class="section-card" id="bukti-member">
      <div class="presence-header">
        <div>
          <h3>Bukti Presensi Member</h3>
          <p>Screenshot presensi per member — dari member maupun yang kamu unggah di atas.</p>
        </div>
        <span class="presence-session-count"><i class="fas fa-camera"></i> <%= submissions.length %> bukti</span>
      </div>

      <% if (submissions.length === 0) { %>
        <div class="empty-state compact"><i class="fas fa-user-check"></i><p>Belum ada bukti presensi.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr><th>Dikirim</th><th>Member</th><th>Periode</th><th>Program</th><th>Meeting</th><th>Bukti</th></tr>
            </thead>
            <tbody>
              <% submissions.forEach(s => { %>
                <tr>
                  <td><%= formatDate(s.created_at) %></td>
                  <td>
                    <div class="member-name-cell">
                      <% if (s.member_photo) { %><img src="<%= s.member_photo %>" class="table-avatar" alt="<%= s.member_name %>">
                      <% } else { %><div class="table-avatar-init"><%= getInitials(s.member_name) %></div><% } %>
                      <%= s.member_name %>
                    </div>
                  </td>
                  <td><%= s.period_label %></td>
                  <td><%= s.program_name || '-' %></td>
                  <td><span class="badge-pill badge-completed">#<%= s.meeting_number %></span></td>
                  <td>
                    <% if (s.screenshot) { %>
                      <a href="<%= s.screenshot %>" target="_blank" rel="noopener" class="proof-link">
                        <img src="<%= s.screenshot %>" alt="bukti" class="proof-mini">
                      </a>
                    <% } else { %>-<% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
