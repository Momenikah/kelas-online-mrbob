<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'tutor' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/tutor" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Kelola Presensi</h1>
    <p class="sub-banner-desc">Satu tempat untuk presensi tutor, check-in member, dan bukti kehadiran.</p>
  </div>

  <div class="container">
    <div class="section-card presence-session-card">
      <div class="presence-session-head">
        <h3 class="section-title"><i class="fas fa-search"></i> Pilih Sesi</h3>
        <span class="presence-session-count"><i class="fas fa-calendar-check"></i> <%= schedules.length %> sesi</span>
      </div>

      <% if (selectedSchedule) { %>
        <div class="presence-selected-session">
          <div class="presence-date-tile">
            <strong><%= new Date(selectedSchedule.date).toLocaleDateString('id-ID', { day: '2-digit' }) %></strong>
            <span><%= new Date(selectedSchedule.date).toLocaleDateString('id-ID', { month: 'short' }) %></span>
          </div>
          <div class="presence-selected-body">
            <div class="presence-selected-title">
              <h4><%= selectedSchedule.title %></h4>
              <span class="badge-pill badge-<%= selectedSchedule.status %>">
                <%= selectedSchedule.status === 'upcoming' ? 'Akan Datang' : 'Selesai' %>
              </span>
            </div>
            <div class="presence-selected-meta">
              <span><i class="fas fa-clock"></i> <%= formatTime(selectedSchedule.start_time) %> - <%= formatTime(selectedSchedule.end_time) %></span>
              <span><i class="fas fa-book-open"></i> <%= selectedSchedule.program_name %></span>
              <span><i class="fas fa-users"></i> <%= members.length %> member</span>
            </div>
          </div>
        </div>
      <% } %>

      <form action="/tutor/presence" method="GET" class="presence-session-form">
        <label class="presence-session-label" for="presenceSchedule">
          <i class="fas fa-list-ul"></i> Ganti sesi presensi
        </label>
        <div class="presence-select-shell">
          <select id="presenceSchedule" name="schedule_id" class="form-input presence-session-select" onchange="this.form.submit()">
            <option value="">Pilih sesi yang akan diisi presensinya</option>
            <% schedules.forEach(s => { %>
              <option value="<%= s.id %>" <%= selectedId == s.id ? 'selected' : '' %>>
                <%= formatDate(s.date) %> | <%= formatTime(s.start_time) %> - <%= formatTime(s.end_time) %> | <%= s.title %> (<%= s.program_name %>)
              </option>
            <% }) %>
          </select>
          <i class="fas fa-chevron-down"></i>
        </div>
      </form>

      <% if (schedules.length > 0) { %>
        <div class="presence-quick-list">
          <% schedules.slice(0, 4).forEach(s => { %>
            <a href="/tutor/presence?schedule_id=<%= s.id %>" class="presence-quick-item <%= selectedId == s.id ? 'is-active' : '' %>">
              <span class="presence-quick-date">
                <strong><%= new Date(s.date).toLocaleDateString('id-ID', { day: '2-digit' }) %></strong>
                <small><%= new Date(s.date).toLocaleDateString('id-ID', { month: 'short' }) %></small>
              </span>
              <span class="presence-quick-main">
                <strong><%= s.title %></strong>
                <small><i class="fas fa-clock"></i> <%= formatTime(s.start_time) %> - <%= formatTime(s.end_time) %> | <%= s.program_name %></small>
              </span>
              <span class="badge-pill badge-<%= s.status %>"><%= s.status === 'upcoming' ? 'Akan Datang' : 'Selesai' %></span>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state compact"><i class="fas fa-calendar-xmark"></i><p>Belum ada sesi untuk presensi.</p></div>
      <% } %>
    </div>

    <% if (selectedSchedule) { %>
      <div class="section-card">
        <div class="presence-header">
          <div>
            <h3><%= selectedSchedule.title %></h3>
            <p><%= formatDate(selectedSchedule.date) %> | <%= formatTime(selectedSchedule.start_time) %> - <%= formatTime(selectedSchedule.end_time) %></p>
          </div>
          <span class="badge-pill badge-<%= selectedSchedule.status %>">
            <%= selectedSchedule.status === 'upcoming' ? 'Akan Datang' : 'Selesai' %>
          </span>
        </div>

        <% if (members.length === 0) { %>
          <div class="empty-state"><i class="fas fa-users"></i><p>Tidak ada peserta terdaftar.</p></div>
        <% } else { %>
          <% const sum = { present:0, late:0, excused:0, absent:0 }; members.forEach(m => { if (sum[m.status] !== undefined) sum[m.status] += 1; }); %>
          <div class="presence-summary">
            <span class="ps-chip ps-present"><i class="fas fa-check"></i> Hadir: <strong><%= sum.present %></strong></span>
            <span class="ps-chip ps-late"><i class="fas fa-clock"></i> Terlambat: <strong><%= sum.late %></strong></span>
            <span class="ps-chip ps-excused"><i class="fas fa-envelope"></i> Izin: <strong><%= sum.excused %></strong></span>
            <span class="ps-chip ps-absent"><i class="fas fa-xmark"></i> Absen: <strong><%= sum.absent %></strong></span>
            <span class="ps-chip ps-total"><i class="fas fa-users"></i> Total: <strong><%= members.length %></strong></span>
          </div>

          <% const withPhoneCount = members.filter(m => m.phone).length; %>
          <% if (withPhoneCount > 0) { %>
          <div class="presence-reminder-bar">
            <span><i class="fab fa-whatsapp"></i> Ingatkan peserta via WhatsApp untuk sesi ini.</span>
            <button type="button" class="btn btn-sm btn-whatsapp" id="remindAllBtn" data-total="<%= withPhoneCount %>">
              <i class="fab fa-whatsapp"></i> Ingatkan Semua (<%= withPhoneCount %>)
            </button>
          </div>
          <% } %>

          <%
            // WhatsApp follow-up (reminder) toward a member for this session.
            function waFollowupHref(phone, lines) {
              const digits = String(phone || '').replace(/\D/g, '');
              let p = digits;
              if (p.startsWith('0')) p = '62' + p.slice(1);
              else if (p.startsWith('8')) p = '62' + p;
              const text = encodeURIComponent(lines.filter(Boolean).join('\n'));
              return p ? `https://wa.me/${p}?text=${text}` : `https://api.whatsapp.com/send?text=${text}`;
            }
          %>
          <form action="/tutor/presence/<%= selectedSchedule.id %>" method="POST" id="presenceForm">
            <div class="presence-table-wrapper">
              <table class="data-table">
                <thead>
                  <tr><th>#</th><th>Nama Member</th><th>Status Kehadiran</th><th>Check-in</th><th>Catatan</th></tr>
                </thead>
                <tbody>
                  <% members.forEach((m, idx) => { %>
                    <tr>
                      <td><%= idx + 1 %></td>
                      <td>
                        <div class="member-name-cell">
                          <% if (m.photo) { %>
                            <img src="<%= m.photo %>" class="table-avatar" alt="<%= m.name %>">
                          <% } else { %>
                            <div class="table-avatar-init"><%= getInitials(m.name) %></div>
                          <% } %>
                          <span class="member-name-text"><%= m.name %></span>
                          <% if (m.phone) {
                               const waHref = waFollowupHref(m.phone, [
                                 `Halo ${m.name}, mengingatkan jadwal kelas kamu 📣`,
                                 `📚 ${selectedSchedule.title || selectedSchedule.program_name || 'Kelas'}`,
                                 `🗓️ ${formatDate(selectedSchedule.date)}`,
                                 `⏰ ${formatTime(selectedSchedule.start_time)} - ${formatTime(selectedSchedule.end_time)} WIB`,
                                 `👨‍🏫 Tutor: ${user.name}`,
                                 selectedSchedule.location ? `📍 ${selectedSchedule.location}` : '',
                                 selectedSchedule.meeting_link ? `🔗 Link kelas: ${selectedSchedule.meeting_link}` : '',
                                 `Mohon hadir tepat waktu ya 🙏`
                               ]);
                          %>
                            <a href="<%= waHref %>" target="_blank" rel="noopener" class="wa-followup-btn" title="Follow up / ingatkan via WhatsApp"><i class="fab fa-whatsapp"></i></a>
                          <% } else { %>
                            <span class="wa-followup-missing" title="Nomor WhatsApp belum tersedia"><i class="fas fa-phone-slash"></i></span>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <div class="presence-radio-group">
                          <label class="presence-radio present">
                            <input type="radio" name="presences[m<%= m.id %>]" value="present" <%= m.status === 'present' ? 'checked' : '' %>>
                            <span>Hadir</span>
                          </label>
                          <label class="presence-radio late">
                            <input type="radio" name="presences[m<%= m.id %>]" value="late" <%= m.status === 'late' ? 'checked' : '' %>>
                            <span>Terlambat</span>
                          </label>
                          <label class="presence-radio excused">
                            <input type="radio" name="presences[m<%= m.id %>]" value="excused" <%= m.status === 'excused' ? 'checked' : '' %>>
                            <span>Izin</span>
                          </label>
                          <label class="presence-radio absent">
                            <input type="radio" name="presences[m<%= m.id %>]" value="absent" <%= m.status === 'absent' ? 'checked' : '' %>>
                            <span>Absen</span>
                          </label>
                        </div>
                      </td>
                      <td><%= m.check_in_time ? new Date(m.check_in_time).toLocaleString('id-ID', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) : '-' %></td>
                      <td>
                        <input type="text" name="notes[m<%= m.id %>]" class="form-input" value="<%= m.notes || '' %>" placeholder="Catatan opsional">
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </form>
        <% } %>

        <div class="presence-subsection" id="foto-kelas">
          <div class="presence-subhead">
            <h4><i class="fas fa-camera-retro"></i> Foto Kelas</h4>
            <span class="presence-session-count"><i class="fas fa-images"></i> <%= classProofs.length %> foto</span>
          </div>
          <p class="presence-subdesc">Unggah dokumentasi kelas (screenshot/foto). Tutor &amp; member bisa menambahkan.</p>

        <form action="/tutor/presence/<%= selectedSchedule.id %>/class-proof" method="POST" enctype="multipart/form-data" class="class-proof-form">
          <label class="class-proof-drop" id="classProofDrop">
            <input type="file" name="class_photo" accept="image/*" required id="classProofInput">
            <span class="class-proof-drop-inner">
              <i class="fas fa-cloud-arrow-up"></i>
              <b>Pilih gambar</b>
              <small>JPG/PNG/WEBP, maks. 5MB</small>
            </span>
            <img class="class-proof-preview" id="classProofPreview" alt="preview" hidden>
          </label>
          <div class="class-proof-form-side">
            <input type="text" name="caption" class="form-input" maxlength="255" placeholder="Keterangan (opsional), mis. Sesi Speaking 1">
            <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> Unggah Foto</button>
          </div>
        </form>

        <% if (classProofs.length === 0) { %>
          <div class="empty-state compact"><i class="fas fa-image"></i><p>Belum ada foto kelas untuk sesi ini.</p></div>
        <% } else { %>
          <div class="class-proof-gallery">
            <% classProofs.forEach(cp => { %>
              <figure class="class-proof-item">
                <a href="<%= cp.image %>" target="_blank" rel="noopener">
                  <img src="<%= cp.image %>" alt="<%= cp.caption || 'Foto kelas' %>" loading="lazy">
                </a>
                <figcaption>
                  <span class="cp-meta">
                    <b><%= cp.caption || 'Foto kelas' %></b>
                    <small>
                      <i class="fas fa-<%= cp.uploader_role === 'member' ? 'user-graduate' : 'chalkboard-teacher' %>"></i>
                      <%= cp.uploader_name || (cp.uploader_role === 'member' ? 'Member' : 'Tutor') %> · <%= formatDate(cp.created_at) %>
                    </small>
                  </span>
                  <form action="/tutor/presence/class-proof/<%= cp.id %>/delete" method="POST" onsubmit="return confirm('Hapus foto ini?')">
                    <button class="cp-del" title="Hapus"><i class="fas fa-trash"></i></button>
                  </form>
                </figcaption>
              </figure>
            <% }) %>
          </div>
        <% } %>
        </div>

        <% if (members.length > 0) { %>
          <div class="presence-actions">
            <button type="button" class="btn btn-outline" id="markAllPresent">
              <i class="fas fa-check-double"></i> Tandai Semua Hadir
            </button>
            <button type="submit" form="presenceForm" class="btn btn-primary btn-save-presence">
              <i class="fas fa-save"></i> Simpan Presensi
            </button>
          </div>
          <script>
            document.getElementById('markAllPresent').addEventListener('click', function () {
              document.querySelectorAll('input[type="radio"][value="present"]').forEach(function (r) { r.checked = true; });
            });

            // "Ingatkan Semua": step through each participant's WhatsApp one click at
            // a time, so every window.open stays inside a user gesture (no popup block).
            (function () {
              var btn = document.getElementById('remindAllBtn');
              if (!btn) return;
              var links = Array.prototype.map.call(
                document.querySelectorAll('#presenceForm .wa-followup-btn'),
                function (a) { return a.href; }
              );
              var total = links.length;
              var idx = 0;
              var baseLabel = '<i class="fab fa-whatsapp"></i> Ingatkan Semua (' + total + ')';
              btn.addEventListener('click', function () {
                if (idx >= total) { idx = 0; btn.innerHTML = baseLabel; btn.classList.remove('is-done'); return; }
                window.open(links[idx], '_blank', 'noopener');
                idx += 1;
                if (idx >= total) {
                  btn.innerHTML = '<i class="fas fa-check"></i> Selesai — ulangi?';
                  btn.classList.add('is-done');
                } else {
                  btn.innerHTML = '<i class="fab fa-whatsapp"></i> Ingatkan berikutnya (' + (idx + 1) + '/' + total + ')';
                }
              });
            })();
          </script>
        <% } %>
      </div>
    <% } %>

    <div class="section-card" id="bukti-member">
      <div class="presence-header">
        <div>
          <h3>Bukti Presensi Member</h3>
          <p>Screenshot dan laporan presensi yang dikirim member untuk kelas Anda.</p>
        </div>
        <span class="presence-session-count"><i class="fas fa-camera"></i> <%= submissions.length %> bukti</span>
      </div>

      <% if (submissions.length === 0) { %>
        <div class="empty-state compact"><i class="fas fa-user-check"></i><p>Belum ada bukti presensi dari member.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr><th>Dikirim</th><th>Member</th><th>Periode</th><th>Program</th><th>Meeting</th><th>Bukti</th></tr>
            </thead>
            <tbody>
              <% submissions.forEach(s => { %>
                <tr>
                  <td><%= formatDate(s.created_at) %></td>
                  <td>
                    <div class="member-name-cell">
                      <% if (s.member_photo) { %><img src="<%= s.member_photo %>" class="table-avatar" alt="<%= s.member_name %>">
                      <% } else { %><div class="table-avatar-init"><%= getInitials(s.member_name) %></div><% } %>
                      <%= s.member_name %>
                    </div>
                  </td>
                  <td><%= s.period_label %></td>
                  <td><%= s.program_name || '-' %></td>
                  <td><span class="badge-pill badge-completed">#<%= s.meeting_number %></span></td>
                  <td>
                    <% if (s.screenshot) { %>
                      <a href="<%= s.screenshot %>" target="_blank" rel="noopener" class="proof-link">
                        <img src="<%= s.screenshot %>" alt="bukti" class="proof-mini">
                      </a>
                    <% } else { %>-<% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
(function () {
  var input = document.getElementById('classProofInput');
  if (!input) return;
  var preview = document.getElementById('classProofPreview');
  var drop = document.getElementById('classProofDrop');
  input.addEventListener('change', function () {
    var file = input.files && input.files[0];
    if (!file) { preview.hidden = true; drop.classList.remove('has-file'); return; }
    preview.src = URL.createObjectURL(file);
    preview.hidden = false;
    drop.classList.add('has-file');
  });
})();
</script>

<%- include('../partials/footer') %>
