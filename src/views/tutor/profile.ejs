<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'tutor' }) %>

<div class="page-wrapper">
  <div class="sub-banner">
    <a href="/tutor" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Profile Settings</h1>
  </div>

  <div class="container">
    <%- include('../partials/flash') %>

    <form action="/tutor/profile" method="POST" enctype="multipart/form-data" class="settings-layout">
      <aside class="settings-sidebar">
        <div class="settings-photo-card">
          <div class="settings-avatar" id="photoPreview">
            <% if (profile.photo) { %>
              <img src="<%= profile.photo %>" alt="Foto profil" class="preview-img">
            <% } else { %>
              <span><%= getInitials(profile.name) %></span>
            <% } %>
          </div>
          <h2><%= profile.name %></h2>
          <p><%= profile.email %></p>
          <span class="settings-role">Tutor</span>

          <label class="settings-upload-btn">
            <i class="fas fa-camera"></i>
            <span>Ganti Foto</span>
            <input type="file" name="photo" id="photoInput" accept="image/*">
          </label>
          <small id="photoFileName">JPG, PNG, GIF, WEBP maks. 5MB</small>
        </div>

        <div class="settings-info-card">
          <div>
            <i class="fas fa-chalkboard-teacher"></i>
            <span>Area</span>
            <strong>Tutor</strong>
          </div>
          <div>
            <i class="fas fa-shield-alt"></i>
            <span>Status Akun</span>
            <strong>Aktif</strong>
          </div>
        </div>
      </aside>

      <section class="settings-main">
        <div class="settings-section">
          <div class="settings-section-head">
            <div>
              <p>Informasi Profil</p>
              <h2>Data Pengajar</h2>
            </div>
            <i class="fas fa-user"></i>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Nama Lengkap</label>
              <input type="text" name="name" class="form-input" value="<%= profile.name %>" required>
            </div>
            <div class="form-group">
              <label class="form-label">Email</label>
              <input type="email" class="form-input" value="<%= profile.email %>" disabled>
              <small class="form-hint">Email dipakai sebagai identitas login dan tidak dapat diubah.</small>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Nomor WhatsApp</label>
            <input type="tel" name="phone" class="form-input" value="<%= profile.phone || '' %>" placeholder="08xxxxxxxxxx">
          </div>

          <div class="form-group">
            <div class="label-row">
              <label class="form-label">Bio Pengajar</label>
              <small id="bioCounter">0/420</small>
            </div>
            <textarea name="bio" id="bioInput" class="form-textarea" rows="5" maxlength="420" placeholder="Pengalaman mengajar, keahlian, dan gaya mengajar..."><%= profile.bio || '' %></textarea>
          </div>
        </div>

        <div class="settings-section">
          <div class="settings-section-head">
            <div>
              <p>Keamanan</p>
              <h2>Ubah Password</h2>
            </div>
            <i class="fas fa-lock"></i>
          </div>

          <div class="security-note">
            Isi bagian ini hanya jika ingin mengganti password. Biarkan kosong jika tidak ada perubahan.
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Password Lama</label>
              <input type="password" name="current_password" class="form-input password-setting-input" autocomplete="current-password">
            </div>
            <div class="form-group">
              <label class="form-label">Password Baru</label>
              <input type="password" name="new_password" id="newPassword" class="form-input password-setting-input" minlength="6" autocomplete="new-password">
              <small class="form-hint" id="passwordHint">Minimal 6 karakter.</small>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Konfirmasi Password Baru</label>
            <input type="password" name="confirm_password" class="form-input password-setting-input" minlength="6" autocomplete="new-password">
          </div>
        </div>

        <div class="settings-actions">
          <a href="/tutor" class="btn btn-outline">Batal</a>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Simpan Settings
          </button>
        </div>
      </section>
    </form>
  </div>
</div>

<script>
const photoInput = document.getElementById('photoInput');
const photoPreview = document.getElementById('photoPreview');
const photoFileName = document.getElementById('photoFileName');
const bioInput = document.getElementById('bioInput');
const bioCounter = document.getElementById('bioCounter');
const newPassword = document.getElementById('newPassword');
const passwordHint = document.getElementById('passwordHint');

function updateBioCounter() {
  bioCounter.textContent = `${bioInput.value.length}/420`;
}

photoInput.addEventListener('change', () => {
  const file = photoInput.files[0];
  if (!file) return;
  photoFileName.textContent = file.name;
  photoPreview.innerHTML = `<img src="${URL.createObjectURL(file)}" alt="Preview foto" class="preview-img">`;
});

bioInput.addEventListener('input', updateBioCounter);
newPassword.addEventListener('input', () => {
  passwordHint.textContent = newPassword.value && newPassword.value.length < 6
    ? 'Password masih terlalu pendek.'
    : 'Minimal 6 karakter.';
});
updateBioCounter();
</script>

<%- include('../partials/footer') %>
