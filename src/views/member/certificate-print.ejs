<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    const d = cert.details || {};
    const scores = d.scores || {};
    const improvement = d.improvement || {};
    const recipientName = cert.member_name || user.name;
    const category = d.category || '';
    const categoryLower = String(category).toLowerCase();
    const isToefl = categoryLower.includes('toefl');
    const isIelts = categoryLower.includes('ielts');
    const hasPersonalReport = categoryLower.includes('speaking') || categoryLower.includes('holiday');
    const programName = d.program_label || cert.program_name || '-';
    const periodLabel = d.period_label || formatDate(cert.issued_date);
    const gradeRaw = d.grade || '-';
    const gradeText = /^grade\s/i.test(gradeRaw) ? gradeRaw : `Grade ${gradeRaw}`;
    const issueDate = cert.issued_date ? new Date(cert.issued_date) : new Date();
    const dateSlash = `${String(issueDate.getDate()).padStart(2, '0')}/${String(issueDate.getMonth() + 1).padStart(2, '0')}/${issueDate.getFullYear()}`;
    const certNo = cert.certificate_number || '';
    const testTitle = isIelts ? 'IELTS Test' : 'TOEFL Test';
    const resultLabel = (value) => {
      const score = Number(value);
      if (Number.isNaN(score)) return '-';
      if (score >= 5) return 'Excellent';
      if (score >= 4) return 'Very Good';
      if (score >= 3) return 'Good';
      if (score >= 2) return 'Fair';
      return 'Need Improvement';
    };
    const show = (value, fallback = '-') => (value !== undefined && value !== null && String(value).trim() !== '' ? value : fallback);
  %>
  <title>Sertifikat - <%= recipientName %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 24px;
      background: #2f2f2f;
      color: #000;
      font-family: "DM Sans", Arial, sans-serif;
    }
    .toolbar {
      max-width: 820px;
      margin: 0 auto 16px;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
    .toolbar a,
    .toolbar button {
      border: 0;
      border-radius: 8px;
      padding: 10px 16px;
      background: #fff;
      color: #252525;
      font: inherit;
      font-weight: 800;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 8px 22px rgba(0,0,0,.18);
    }
    .toolbar button { background: #8b3fe5; color: #fff; }
    .print-stack {
      display: grid;
      gap: 18px;
      justify-content: center;
    }
    .sheet {
      position: relative;
      width: min(794px, calc(100vw - 48px));
      background: #fff;
      box-shadow: 0 8px 30px rgba(0,0,0,.35);
      overflow: hidden;
      page-break-after: always;
      break-after: page;
      container-type: inline-size;
    }
    .sheet:last-child { page-break-after: auto; break-after: auto; }
    .sheet-general { aspect-ratio: 2086 / 2947; }
    .sheet-test { aspect-ratio: 1414 / 2000; }
    .sheet-report { aspect-ratio: 2086 / 2947; }
    /* Value overlays positioned/sized relative to the sheet (cqw = 1% of sheet width). */
    .v {
      position: absolute;
      z-index: 1;
      color: #111;
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 800;
      line-height: 1.1;
    }
    .v.c { transform: translate(-50%, -50%); text-align: center; }
    .v.l { transform: translateY(-50%); }
    .template-img {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      object-fit: fill;
      user-select: none;
      pointer-events: none;
    }
    .sheet > :not(.template-img) { z-index: 1; }
    .abs { position: absolute; line-height: 1.15; }
    .top-code {
      top: 5.1%;
      right: 10.2%;
      width: 28%;
      text-align: right;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(9px, 1vw, 13px);
    }
    .serif {
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 800;
      letter-spacing: .2px;
    }
    .test-name {
      left: 10.8%;
      top: 40.4%;
      width: 78%;
      font-size: clamp(26px, 4.1vw, 43px);
    }
    .test-title {
      left: 10.8%;
      top: 50.8%;
      width: 78%;
      font-size: clamp(25px, 3.9vw, 42px);
    }
    .score-list {
      left: 11%;
      top: 58.1%;
      width: 66%;
      display: grid;
      gap: .55em;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(15px, 2vw, 23px);
      font-weight: 800;
    }
    .score-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 24px 120px;
      align-items: baseline;
    }
    .test-period {
      left: 10.8%;
      top: 69.6%;
      width: 78%;
      font-size: clamp(19px, 2.7vw, 31px);
    }
    @media print {
      body { padding: 0; background: #fff; }
      .toolbar { display: none; }
      .print-stack { display: block; }
      .sheet {
        width: 210mm;
        height: 296.8mm;
        box-shadow: none;
        margin: 0;
      }
      @page { size: A4 portrait; margin: 0; }
    }
  </style>
</head>
<body>
  <% if (typeof embed === 'undefined' || !embed) { %>
  <div class="toolbar">
    <a href="<%= backHref || (user.role === 'admin' ? '/admin/certificate' : user.role === 'tutor' ? '/tutor/certificate' : '/member/certificate') %>">&larr; Kembali</a>
    <button onclick="window.print()">Download PDF</button>
  </div>
  <% } %>

  <main class="print-stack">
    <% if (isToefl || isIelts) { %>
      <section class="sheet sheet-test">
        <img class="template-img" src="/img/certificates/template-TOEFL-IELTS-1.png" alt="">
        <div class="abs top-code"><%= dateSlash %>/<%= certNo %></div>
        <div class="abs test-name serif"><%= recipientName %></div>
        <div class="abs test-title serif"><%= testTitle %></div>
        <div class="abs score-list">
          <% if (isToefl) { %>
            <div class="score-row"><span>Listening Comprehension</span><span>:</span><span><%= show(scores.listening_score) %></span></div>
            <div class="score-row"><span>Structure & Written Comprehension</span><span>:</span><span><%= show(scores.structure_score) %></span></div>
            <div class="score-row"><span>Reading Comprehension</span><span>:</span><span><%= show(scores.reading_score) %></span></div>
          <% } else { %>
            <div class="score-row"><span>Listening</span><span>:</span><span><%= show(scores.listening_score, '') %></span></div>
            <div class="score-row"><span>Reading</span><span>:</span><span><%= show(scores.reading_score, '') %></span></div>
            <div class="score-row"><span>Writing</span><span>:</span><span><%= show(scores.writing_score, '') %></span></div>
            <div class="score-row"><span>Speaking</span><span>:</span><span><%= show(scores.speaking_score, '') %></span></div>
          <% } %>
          <div class="score-row" style="font-size:1.25em"><span>Total Score</span><span>:</span><span><%= show(scores.total_score) %></span></div>
        </div>
        <div class="abs test-period serif">Date of periode : <%= periodLabel %></div>
      </section>
    <% } else { %>
      <section class="sheet sheet-general">
        <img class="template-img" src="/img/certificates/sertifikat-umum.png" alt="">
        <div class="v l" style="left:12%;top:41.8%;font-size:3.2cqw;"><%= recipientName %></div>
        <div class="v l" style="left:12%;top:50.5%;font-size:3cqw;"><%= gradeText %></div>
        <div class="v l" style="left:12%;top:59.2%;font-size:2.9cqw;"><%= programName %></div>
        <div class="v l" style="left:12%;top:67.2%;font-size:2.4cqw;"><%= periodLabel %></div>
      </section>
    <% } %>

    <% if (hasPersonalReport) {
         const miniVals = [scores.speaking_score, scores.vocabulary_score, scores.grammar_score, scores.pronunciation_score, scores.understanding_score, scores.cefr_score];
         const miniX = [18.7, 32.2, 45.6, 59, 72.4, 85.9];
         const rowKeys = ['speaking_score', 'vocabulary_score', 'grammar_score', 'pronunciation_score', 'understanding_score'];
         const noteKeys = ['speaking', 'vocabulary', 'grammar', 'pronunciation', 'understanding'];
         const notes = d.notes || {};
         const rowY = [39.75, 42.85, 46.0, 49.1, 52.25];
    %>
      <section class="sheet sheet-report">
        <img class="template-img" src="/img/certificates/Personal-Report.png" alt="">
        <div class="v l" style="left:31%;top:20.3%;font-size:1.5cqw;font-weight:600;"><%= recipientName %></div>
        <div class="v l" style="left:73%;top:20.3%;font-size:1.5cqw;font-weight:600;"><%= show(d.tutor_name, '-') %></div>
        <% miniVals.forEach((val, i) => { %>
          <div class="v c" style="left:<%= miniX[i] %>%;top:26%;font-size:1.4cqw;"><%= show(val, '') %></div>
        <% }) %>
        <% rowKeys.forEach((key, i) => { %>
          <div class="v c" style="left:39.2%;top:<%= rowY[i] %>%;font-size:1.1cqw;"><%= show(scores[key], '') %></div>
          <div class="v c" style="left:53.7%;top:<%= rowY[i] %>%;font-size:1cqw;"><%= scores[key] ? resultLabel(scores[key]) : '' %></div>
          <div class="v l" style="left:62.5%;top:<%= rowY[i] %>%;width:28.5%;font-size:0.82cqw;font-weight:600;line-height:1.12;"><%= show(notes[noteKeys[i]], '') %></div>
        <% }) %>
        <div class="v l" style="left:12.7%;top:65.5%;width:38%;font-size:1cqw;font-weight:600;line-height:1.25;"><%= show(improvement.before, '') %></div>
        <div class="v l" style="left:54%;top:65.5%;width:38%;font-size:1cqw;font-weight:600;line-height:1.25;"><%= show(improvement.after, '') %></div>
      </section>
    <% } %>
  </main>

  <script>
    <% if (autoPrint !== false) { %>
    window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 500); });
    <% } %>
  </script>
</body>
</html>
