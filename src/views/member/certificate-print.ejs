<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%
    const d = cert.details || {};
    const scores = d.scores || {};
    const improvement = d.improvement || {};
    const recipientName = cert.member_name || user.name;
    const category = d.category || '';
    const categoryLower = String(category).toLowerCase();
    const isToefl = categoryLower.includes('toefl');
    const isIelts = categoryLower.includes('ielts');
    const hasPersonalReport = categoryLower.includes('speaking') || categoryLower.includes('holiday');
    const programName = d.program_label || cert.program_name || '-';
    const periodLabel = d.period_label || formatDate(cert.issued_date);
    const gradeRaw = d.grade || '-';
    const gradeText = /^grade\s/i.test(gradeRaw) ? gradeRaw : `Grade ${gradeRaw}`;
    const issueDate = cert.issued_date ? new Date(cert.issued_date) : new Date();
    const dateSlash = `${String(issueDate.getDate()).padStart(2, '0')}/${String(issueDate.getMonth() + 1).padStart(2, '0')}/${issueDate.getFullYear()}`;
    const certNo = cert.certificate_number || '';
    const testTitle = isIelts ? 'IELTS Test' : 'TOEFL Test';
    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[char]));
    const ordinalHtml = (value) => escapeHtml(value).replace(/(\d+)(st|nd|rd|th)\b/g, '$1<sup>$2</sup>');
    const resultLabel = (value) => {
      const score = Number(value);
      if (Number.isNaN(score)) return '-';
      if (score >= 5) return 'Excellent';
      if (score >= 4) return 'Very Good';
      if (score >= 3) return 'Good';
      if (score >= 2) return 'Fair';
      return 'Need Improvement';
    };
    const show = (value, fallback = '-') => (value !== undefined && value !== null && String(value).trim() !== '' ? value : fallback);
  %>
  <title>Sertifikat - <%= recipientName %></title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 24px;
      background: #2f2f2f;
      color: #000;
      font-family: "DM Sans", Arial, sans-serif;
    }
    .toolbar {
      max-width: 820px;
      margin: 0 auto 16px;
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }
    .toolbar a,
    .toolbar button {
      border: 0;
      border-radius: 8px;
      padding: 10px 16px;
      background: #fff;
      color: #252525;
      font: inherit;
      font-weight: 800;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 8px 22px rgba(0,0,0,.18);
    }
    .toolbar button { background: #8b3fe5; color: #fff; }
    .print-stack {
      display: grid;
      gap: 18px;
      justify-content: center;
    }
    .sheet {
      position: relative;
      width: min(794px, calc(100vw - 48px));
      background: #fff;
      box-shadow: 0 8px 30px rgba(0,0,0,.35);
      overflow: hidden;
      page-break-after: always;
      break-after: page;
      container-type: inline-size;
    }
    .sheet:last-child { page-break-after: auto; break-after: auto; }
    .sheet-general { aspect-ratio: 1240 / 1754; }
    .sheet-test { aspect-ratio: 1414 / 2000; }
    .sheet-report { aspect-ratio: 1414 / 2000; }
    /* Value overlays positioned/sized relative to the sheet (cqw = 1% of sheet width). */
    .v {
      position: absolute;
      z-index: 1;
      color: #111;
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 800;
      line-height: 1.1;
    }
    .v.c { transform: translate(-50%, -50%); text-align: center; }
    .v.l { transform: translateY(-50%); }
    .template-img {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      object-fit: fill;
      user-select: none;
      pointer-events: none;
    }
    .sheet > :not(.template-img) { z-index: 1; }
    .abs { position: absolute; line-height: 1.15; }
    .top-code {
      top: 5.1%;
      right: 10.2%;
      width: 28%;
      text-align: right;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(9px, 1vw, 13px);
    }
    .serif {
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 800;
      letter-spacing: .2px;
    }
    .test-name {
      left: 10.8%;
      top: 40.4%;
      width: 78%;
      font-size: clamp(26px, 4.1vw, 43px);
    }
    .test-title {
      left: 10.8%;
      top: 50.8%;
      width: 78%;
      font-size: clamp(25px, 3.9vw, 42px);
    }
    .score-list {
      left: 11%;
      top: 58.1%;
      width: 66%;
      display: grid;
      gap: .55em;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(15px, 2vw, 23px);
      font-weight: 800;
    }
    .score-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 24px 120px;
      align-items: baseline;
    }
    .test-period {
      left: 10.8%;
      top: 69.6%;
      width: 78%;
      font-size: clamp(19px, 2.7vw, 31px);
    }
    .cert-label {
      left: 12%;
      width: 80%;
      font-size: 2.65cqw;
      font-weight: 500;
      line-height: 1.15;
    }
    .cert-label.certify { top: 37.1%; }
    .cert-label.awarded { top: 46.5%; }
    .cert-label.in-the { top: 54.9%; }
    .cert-label.period-label { top: 63.9%; }
    .cert-value {
      left: 12%;
      width: 78%;
      font-size: 4.65cqw;
      font-weight: 900;
      line-height: 1.05;
    }
    .cert-name { top: 41.1%; }
    .cert-grade { top: 50.3%; }
    .cert-program { top: 58.8%; }
    .cert-period { top: 67.3%; font-size: 2.75cqw; }
    .cert-period sup { font-size: .55em; line-height: 0; vertical-align: super; }
    .cert-stamp {
      position: absolute;
      z-index: 2;
      left: 30.6%;
      top: 73.7%;
      width: 11.8%;
      pointer-events: none;
    }
    .cert-stamp img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
    }
    .report-name-label,
    .report-name-value,
    .report-tutor-label,
    .report-tutor-value {
      transform: none !important;
      top: 20.55%;
      font-size: 1.62cqw;
      font-weight: 800;
      line-height: 1.05;
      overflow-wrap: anywhere;
    }
    .report-name-label { left: 12.1%; width: 16.5%; }
    .report-name-value { left: 28.7%; width: 27%; }
    .report-tutor-label { left: 57%; width: 15.5%; }
    .report-tutor-value { left: 72.6%; width: 20%; }
    .report-score-strip {
      transform: none !important;
      left: 12.1%;
      top: 23.75%;
      width: 80.2%;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      text-align: center;
      font-size: 1.32cqw;
      font-weight: 800;
    }
    .report-score-strip span,
    .report-score-values span {
      position: static;
    }
    .report-score-values {
      transform: none !important;
      left: 12.1%;
      top: 25.05%;
      width: 80.2%;
      height: 1.75%;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      border: 1px solid #111;
      text-align: center;
      align-items: center;
      font-size: 1.45cqw;
      font-weight: 700;
    }
    .report-score-values span:not(:last-child) {
      border-right: 1px solid #111;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .report-main-table {
      transform: none !important;
      left: 12.1%;
      top: 32.5%;
      width: 82%;
      display: grid;
      grid-template-columns: 25% 15% 20% 40%;
      border: 1px solid #111;
      font-size: 1.45cqw;
      text-align: center;
    }
    .report-main-table > div {
      min-height: 4.65cqw;
      border-right: 1px solid #111;
      border-bottom: 1px solid #111;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: .2cqw .55cqw;
      line-height: 1.12;
      font-weight: 600;
      overflow-wrap: anywhere;
    }
    .report-main-table > div:nth-child(4n) { border-right: 0; }
    .report-main-table > div:nth-last-child(-n+4) { border-bottom: 0; }
    .report-main-table .table-head {
      background: #9a00c7;
      color: #fff;
      font-size: 1.48cqw;
      font-weight: 800;
    }
    .report-main-table .section-cell {
      background: #ffd11f;
      font-size: 1.48cqw;
      font-weight: 800;
    }
    .report-main-table .notes-cell {
      text-align: center;
      font-size: 1.18cqw;
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 600;
    }
    .report-improvement-head {
      transform: none !important;
      left: 12.1%;
      top: 64.25%;
      width: 82%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      text-align: center;
      font-size: 1.68cqw;
      font-weight: 800;
    }
    .report-improvement-head span { position: static; }
    .report-improvement-boxes {
      transform: none !important;
      left: 12.1%;
      top: 65.75%;
      width: 82%;
      min-height: 3.85%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      border: 1px solid #111;
    }
    .report-improvement-boxes div {
      position: static;
      padding: .42cqw .75cqw;
      font-size: 1.32cqw;
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 600;
      line-height: 1.12;
      overflow-wrap: anywhere;
    }
    .report-improvement-boxes div:first-child { border-right: 1px solid #111; }
    @media print {
      body { padding: 0; background: #fff; }
      .toolbar { display: none; }
      .print-stack { display: block; }
      .sheet {
        width: 210mm;
        height: 296.8mm;
        box-shadow: none;
        margin: 0;
      }
      @page { size: A4 portrait; margin: 0; }
    }
  </style>
</head>
<body>
  <% if (typeof embed === 'undefined' || !embed) { %>
  <div class="toolbar">
    <a href="<%= backHref || (user.role === 'admin' ? '/admin/certificate' : user.role === 'tutor' ? '/tutor/certificate' : '/member/certificate') %>">&larr; Kembali</a>
    <button onclick="window.print()">Download PDF</button>
  </div>
  <% } %>

  <main class="print-stack">
    <% if (isToefl || isIelts) { %>
      <section class="sheet sheet-test">
        <img class="template-img" src="/img/certificates/template-TOEFL-IELTS-1.png" alt="">
        <div class="abs top-code"><%= dateSlash %>/<%= certNo %></div>
        <div class="abs test-name serif"><%= recipientName %></div>
        <div class="abs test-title serif"><%= testTitle %></div>
        <div class="abs score-list">
          <% if (isToefl) { %>
            <div class="score-row"><span>Listening Comprehension</span><span>:</span><span><%= show(scores.listening_score) %></span></div>
            <div class="score-row"><span>Structure & Written Comprehension</span><span>:</span><span><%= show(scores.structure_score) %></span></div>
            <div class="score-row"><span>Reading Comprehension</span><span>:</span><span><%= show(scores.reading_score) %></span></div>
          <% } else { %>
            <div class="score-row"><span>Listening</span><span>:</span><span><%= show(scores.listening_score, '') %></span></div>
            <div class="score-row"><span>Reading</span><span>:</span><span><%= show(scores.reading_score, '') %></span></div>
            <div class="score-row"><span>Writing</span><span>:</span><span><%= show(scores.writing_score, '') %></span></div>
            <div class="score-row"><span>Speaking</span><span>:</span><span><%= show(scores.speaking_score, '') %></span></div>
          <% } %>
          <div class="score-row" style="font-size:1.25em"><span>Total Score</span><span>:</span><span><%= show(scores.total_score) %></span></div>
        </div>
        <div class="abs test-period serif">Date of periode : <%= periodLabel %></div>
      </section>
    <% } else { %>
      <section class="sheet sheet-general">
        <img class="template-img" src="/img/certificates/sertif-terbaru.jpg" alt="">
        <div class="v l cert-label certify">This is to Certify that</div>
        <div class="v l cert-value cert-name"><%= recipientName %></div>
        <div class="v l cert-label awarded">Has been awarded</div>
        <div class="v l cert-value cert-grade"><%= gradeText %></div>
        <div class="v l cert-label in-the">In The</div>
        <div class="v l cert-value cert-program"><%= programName %></div>
        <div class="v l cert-label period-label">Date of Period :</div>
        <div class="v l cert-value cert-period"><%- ordinalHtml(periodLabel) %></div>
        <div class="cert-stamp" aria-hidden="true">
          <img src="/img/certificate-stamp-super-seru.png" alt="">
        </div>
      </section>
    <% } %>

    <% if (hasPersonalReport) {
         const miniVals = [scores.speaking_score, scores.vocabulary_score, scores.grammar_score, scores.pronunciation_score, scores.understanding_score, scores.cefr_score];
         const miniX = [18.7, 32.2, 45.6, 59, 72.4, 85.9];
         const rowKeys = ['speaking_score', 'vocabulary_score', 'grammar_score', 'pronunciation_score', 'understanding_score'];
         const noteKeys = ['speaking', 'vocabulary', 'grammar', 'pronunciation', 'understanding'];
         const notes = d.notes || {};
         const rowY = [39.75, 42.85, 46.0, 49.1, 52.25];
    %>
      <section class="sheet sheet-report">
        <img class="template-img" src="/img/certificates/report-member-terbaru.png" alt="">
        <div class="v l report-name-label">Member's Name :</div>
        <div class="v l report-name-value"><%= recipientName %></div>
        <div class="v l report-tutor-label">Tutor's Name :</div>
        <div class="v l report-tutor-value"><%= show(d.tutor_name, '-') %></div>
        <div class="v l report-score-strip">
          <span>Speaking</span><span>Vocabulary</span><span>Grammar</span><span>Pronunciation</span><span>Understanding</span><span></span>
        </div>
        <div class="v l report-score-values">
          <% miniVals.forEach((val) => { %><span><%= show(val, '') %></span><% }) %>
        </div>
        <div class="v l report-main-table">
          <div class="table-head">Section</div><div class="table-head">Score</div><div class="table-head">Result</div><div class="table-head">Notes</div>
          <% rowKeys.forEach((key, i) => { %>
            <div class="section-cell"><%= ['Speaking', 'Vocabulary', 'Grammar', 'Pronunciation', 'Understanding'][i] %></div>
            <div><%= show(scores[key], '') %></div>
            <div><%= scores[key] ? resultLabel(scores[key]) : '' %></div>
            <div class="notes-cell"><%= show(notes[noteKeys[i]], '') %></div>
          <% }) %>
        </div>
        <div class="v l report-improvement-head"><span>Before</span><span>After</span></div>
        <div class="v l report-improvement-boxes">
          <div><%= show(improvement.before, '') %></div>
          <div><%= show(improvement.after, '') %></div>
        </div>
      </section>
    <% } %>
  </main>

  <script>
    <% if (autoPrint !== false) { %>
    window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 500); });
    <% } %>
  </script>
</body>
</html>
