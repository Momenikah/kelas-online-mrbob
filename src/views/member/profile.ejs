<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<div class="page-wrapper">
  <div class="sub-banner">
    <a href="/member" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Edit Profil</h1>
  </div>

  <div class="container">
    <%- include('../partials/flash') %>

    <div class="profile-form-card">
      <div class="profile-photo-section">
        <div class="profile-photo-preview" id="photoPreview">
          <% if (profile.photo) { %>
            <img src="<%= profile.photo %>" alt="Foto" class="preview-img" id="previewImg">
          <% } else { %>
            <div class="avatar-initials avatar-xl" id="previewInitials"><%= getInitials(profile.name) %></div>
          <% } %>
        </div>
        <label class="btn btn-outline btn-sm photo-upload-btn">
          <i class="fas fa-camera"></i> Ganti Foto
          <input type="file" name="photo" accept="image/*" id="photoInput" hidden onchange="previewPhoto(this)">
        </label>
      </div>

      <form action="/member/profile" method="POST" enctype="multipart/form-data">
        <input type="file" name="photo" id="photoInputHidden" hidden>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Nama Lengkap</label>
            <input type="text" name="name" class="form-input" value="<%= profile.name %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" class="form-input" value="<%= profile.email %>" disabled>
            <small class="form-hint">Email tidak dapat diubah</small>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Nomor HP</label>
            <input type="tel" name="phone" class="form-input" value="<%= profile.phone || '' %>" placeholder="08xxxxxxxxxx">
          </div>
          <div class="form-group">
            <label class="form-label">Role</label>
            <input type="text" class="form-input" value="<%= profile.role %>" disabled>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Bio / Tentang Saya</label>
          <textarea name="bio" class="form-textarea" rows="3" placeholder="Ceritakan sedikit tentang diri Anda..."><%= profile.bio || '' %></textarea>
        </div>

        <div class="form-actions">
          <a href="/member" class="btn btn-outline">Batal</a>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function previewPhoto(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      const preview = document.getElementById('photoPreview');
      preview.innerHTML = `<img src="${e.target.result}" class="preview-img" alt="Preview">`;
      document.querySelector('input[name="photo"]').files = input.files;
    };
    reader.readAsDataURL(input.files[0]);
    // Transfer file to actual form input
    document.querySelector('form input[type="file"][name="photo"]').files = input.files;
  }
}
// Fix: link the visible upload button to the form's file input
document.querySelector('.photo-upload-btn input').addEventListener('change', function() {
  const formInput = document.querySelector('form input[name="photo"]');
  const dt = new DataTransfer();
  dt.items.add(this.files[0]);
  formInput.files = dt.files;
});
</script>

<%- include('../partials/footer') %>
