<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: typeof activeNav !== 'undefined' ? activeNav : 'member' }) %>
<% const questionnaireBasePath = typeof basePath !== 'undefined' ? basePath : '/member/questionnaire'; %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="<%= (typeof activeNav !== 'undefined' && activeNav === 'tutor') ? '/tutor' : '/member' %>" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1><%= title %></h1>
    <p class="sub-banner-desc">Pilih questionnaire, isi jawaban, lalu kirim. Admin hanya melihat hasil yang sudah masuk.</p>
  </div>

  <div class="container">
    <% if (questionnaires.length === 0) { %>
      <div class="empty-state"><i class="fas fa-clipboard-list"></i><p>Belum ada kuesioner tersedia.</p></div>
    <% } else { %>
      <div class="quiz-grid">
        <% questionnaires.forEach(q => { %>
        <% const qHref = `${questionnaireBasePath}/${q.id}${q.tutor_id ? `?tutor_id=${q.tutor_id}` : ''}`; %>
        <div class="quiz-card">
          <div class="quiz-card-header">
            <div class="quiz-icon"><i class="fas fa-clipboard-question"></i></div>
            <div class="quiz-meta-top">
              <span class="quiz-program"><%= q.program_name %></span>
              <% if (q.submitted_at) { %>
                <span class="quiz-status-done"><i class="fas fa-check-circle"></i> Selesai</span>
              <% } else { %>
                <span class="quiz-status-open"><i class="fas fa-circle"></i> Terbuka</span>
              <% } %>
            </div>
          </div>
          <h3 class="quiz-title"><%= q.title %></h3>
          <% if (q.description) { %><p class="quiz-desc"><%= q.description %></p><% } %>
          <div class="quiz-info">
            <% if (q.tutor_name) { %><span><i class="fas fa-chalkboard-teacher"></i> Tutor: <%= q.tutor_name %></span><% } %>
          </div>
          <% if (q.submitted_at) { %>
            <div class="quiz-result">
              <div class="quiz-score-circle">
                <span><%= q.score %></span>
                <small>/ <%= q.max_score %></small>
              </div>
              <span>Skor kamu</span>
            </div>
            <a href="<%= qHref %>" class="btn btn-outline btn-full">
              <i class="fas fa-eye"></i> Lihat Hasil
            </a>
          <% } else { %>
            <a href="<%= qHref %>" class="btn btn-primary btn-full">
              <i class="fas fa-pen"></i> Isi Questionnaire
            </a>
          <% } %>
        </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
