<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <!-- Profile Banner -->
  <div class="profile-banner">
    <h1 class="banner-title">Member Area</h1>
    <div class="profile-avatar">
      <% if (user.photo) { %>
        <img src="<%= user.photo %>" alt="<%= user.name %>" class="avatar-img">
      <% } else { %>
        <div class="avatar-initials"><%= getInitials(user.name) %></div>
      <% } %>
    </div>
    <h2 class="banner-name"><%= user.name %></h2>
    <% if (user.is_luxury) { %>
      <div><span class="vip-badge-banner"><i class="fas fa-gem"></i> Luxury Class</span></div>
    <% } else if (user.is_vip) { %>
      <div><span class="vip-badge-banner"><i class="fas fa-crown"></i> VIP Member</span></div>
    <% } %>
    <a href="/member/profile" class="btn-edit-profile">
      <i class="fas fa-pen-to-square"></i> EDIT PROFILE
    </a>
  </div>

  <!-- Notifications -->
  <% if (notifications && notifications.length > 0) { %>
  <div class="container">
    <div class="notif-bar">
      <i class="fas fa-bell notif-icon"></i>
      <span class="notif-text"><%= notifications[0].title %>: <%= notifications[0].message %></span>
      <button class="notif-close" onclick="markNotifsRead(this.parentElement)"><i class="fas fa-times"></i></button>
    </div>
  </div>
  <% } %>

  <!-- Upcoming Schedule Preview -->
  <% if (upcomingSchedules && upcomingSchedules.length > 0) { %>
  <div class="container">
    <div class="upcoming-banner">
      <i class="fas fa-calendar-check"></i>
      <span>Jadwal berikutnya: <strong><%= upcomingSchedules[0].title %></strong> - <%= formatDate(upcomingSchedules[0].date) %> pukul <%= formatTime(upcomingSchedules[0].start_time) %></span>
      <% if (upcomingSchedules[0].meeting_link) { %>
        <a href="<%= upcomingSchedules[0].meeting_link %>" target="_blank" class="btn-join">
          <i class="fas fa-video"></i> Join
        </a>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- Stats -->
  <div class="container">
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon"><i class="fas fa-graduation-cap"></i></div>
        <div class="stat-info"><span class="stat-value"><%= stats.programs %></span><span class="stat-label">Program Aktif</span></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-rate"><i class="fas fa-calendar-check"></i></div>
        <div class="stat-info"><span class="stat-value"><%= stats.sessions %></span><span class="stat-label">Total Sesi</span></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-present"><i class="fas fa-user-check"></i></div>
        <div class="stat-info"><span class="stat-value"><%= stats.attendanceRate %>%</span><span class="stat-label">Kehadiran</span></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-total"><i class="fas fa-award"></i></div>
        <div class="stat-info"><span class="stat-value"><%= stats.certificates %></span><span class="stat-label">Sertifikat</span></div>
      </div>
    </div>
  </div>

  <% if (user.is_luxury) { %>
  <div class="container">
    <div class="section-card luxury-member-panel">
      <div class="luxury-member-head">
        <div>
          <p>Luxury Class</p>
          <h3>Benefit Aktif</h3>
        </div>
        <span><i class="fas fa-gem"></i> Active</span>
      </div>
      <div class="luxury-member-grid">
        <div class="luxury-member-benefit">
          <i class="fas fa-user-tie"></i>
          <div>
            <strong>Tutor Pilihan</strong>
            <small><%= luxuryAccess && luxuryAccess.preferred_tutor ? luxuryAccess.preferred_tutor : 'Admin akan konfirmasi tutor Grade A.' %></small>
          </div>
        </div>
        <a href="/member/video" class="luxury-member-benefit">
          <i class="fas fa-play-circle"></i>
          <div>
            <strong>Video Premium</strong>
            <small>Akses materi video premium.</small>
          </div>
        </a>
        <a href="/member/toefl" class="luxury-member-benefit">
          <i class="fas fa-trophy"></i>
          <div>
            <strong>Test TOEFL Gratis</strong>
            <small>Latihan dan simulasi TOEFL.</small>
          </div>
        </a>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Pending questionnaires -->
  <% if (pendingQuiz && pendingQuiz.length > 0) { %>
  <div class="container">
    <div class="section-card alert-panel">
      <h3 class="section-title"><i class="fas fa-clipboard-question"></i> Kuesioner Belum Dikerjakan <span class="count-badge"><%= pendingQuiz.length %></span></h3>
      <div class="quiz-pending-list">
        <% pendingQuiz.forEach(q => { %>
        <div class="quiz-pending-item">
          <div>
            <strong><%= q.title %></strong>
            <span class="table-subtext"><%= q.program_name %><% if (q.tutor_name) { %> &middot; <%= q.tutor_name %><% } %></span>
          </div>
          <a href="/member/questionnaire/<%= q.id %><%= q.tutor_id ? '?tutor_id=' + q.tutor_id : '' %>" class="btn btn-sm btn-primary"><i class="fas fa-pen"></i> Kerjakan</a>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Menu Grid -->
  <div class="container">
    <div class="menu-grid">

      <div class="menu-card" onclick="window.location='/member/schedule'">
        <div class="menu-icon-wrap">
          <div class="menu-icon"><i class="fas fa-calendar-alt"></i></div>
        </div>
        <span class="menu-label">Schedule</span>
      </div>

      <div class="menu-card" onclick="window.location='/member/module'">
        <div class="menu-icon-wrap">
          <div class="menu-icon"><i class="fas fa-layer-group"></i></div>
        </div>
        <span class="menu-label">Module</span>
      </div>

      <div class="menu-card" onclick="window.location='/member/presence'">
        <div class="menu-icon-wrap">
          <div class="menu-icon"><i class="fas fa-user-check"></i></div>
        </div>
        <span class="menu-label">Presensi</span>
      </div>

      <div class="menu-card" onclick="window.location='/member/questionnaire'">
        <div class="menu-icon-wrap">
          <div class="menu-icon"><i class="fas fa-table-cells"></i></div>
        </div>
        <span class="menu-label">Questionnaire</span>
      </div>

      <div class="menu-card" onclick="window.location='/member/report'">
        <div class="menu-icon-wrap">
          <div class="menu-icon"><i class="fas fa-file-alt"></i></div>
        </div>
        <span class="menu-label">Member's Report</span>
      </div>

      <div class="menu-card" onclick="window.location='/member/certificate'">
        <div class="menu-icon-wrap">
          <div class="menu-icon"><i class="fas fa-id-card-alt"></i></div>
        </div>
        <span class="menu-label">E-Certificate</span>
      </div>

      <div class="menu-card <%= !user.is_luxury ? 'menu-card-locked' : '' %>" onclick="window.location='/member/toefl'">
        <div class="menu-icon-wrap">
          <span class="card-badge badge-vip">Luxury Class</span>
          <div class="menu-icon menu-icon-vip"><i class="fas fa-trophy"></i></div>
        </div>
        <span class="menu-label">TOEFL Simulation</span>
      </div>

      <div class="menu-card <%= !user.is_luxury ? 'menu-card-locked' : '' %>" onclick="window.location='/member/video'">
        <div class="menu-icon-wrap">
          <span class="card-badge badge-bonus">Luxury Class</span>
          <div class="menu-icon menu-icon-bonus"><i class="fas fa-gift"></i></div>
        </div>
        <span class="menu-label">Video Premium</span>
      </div>

      <div class="menu-card <%= !user.is_luxury ? 'menu-card-locked' : '' %>" onclick="window.location='/member/recording'">
        <div class="menu-icon-wrap">
          <span class="card-badge badge-bonus">Luxury Class</span>
          <div class="menu-icon menu-icon-bonus"><i class="fas fa-video"></i></div>
        </div>
        <span class="menu-label">Recording</span>
      </div>

      <div class="menu-card" onclick="window.location='/member/renewal'">
        <div class="menu-icon-wrap">
          <div class="menu-icon"><i class="fas fa-arrows-rotate"></i></div>
        </div>
        <span class="menu-label">Renewal Program</span>
      </div>

      <div class="menu-card" onclick="window.location='/member/help-support'">
        <div class="menu-icon-wrap">
          <div class="menu-icon"><i class="fas fa-headset"></i></div>
        </div>
        <span class="menu-label">Help & Support</span>
      </div>

      <div class="menu-card menu-card-logout" onclick="if(confirm('Keluar dari akun?')) window.location='/logout'">
        <div class="menu-icon-wrap">
          <div class="menu-icon menu-icon-logout"><i class="fas fa-right-from-bracket"></i></div>
        </div>
        <span class="menu-label menu-label-logout">Log Out</span>
      </div>

    </div>
  </div>

  <!-- Active Enrollments -->
  <% if (enrollments && enrollments.length > 0) { %>
  <div class="container">
    <div class="section-card">
      <h3 class="section-title"><i class="fas fa-graduation-cap"></i> Program Aktif</h3>
      <div class="enrollment-list">
        <% enrollments.forEach(e => { %>
        <div class="enrollment-item">
          <div class="enrollment-icon"><i class="fas fa-book"></i></div>
          <div class="enrollment-info">
            <strong><%= e.program_name %></strong>
            <span>Berlaku hingga: <%= formatDate(e.end_date) %></span>
          </div>
          <span class="badge-status badge-active">Aktif</span>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
  <% } %>

</div>

<script>
function markNotifsRead(el) {
  fetch('/member/notifications/read', { method: 'POST' });
  el.remove();
}
</script>

<%- include('../partials/footer') %>
