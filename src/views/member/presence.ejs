<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/member" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Presensi Kehadiran</h1>
  </div>

  <div class="container">
    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon stat-icon-total"><i class="fas fa-calendar-alt"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= stats.total %></span>
          <span class="stat-label">Total Sesi</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-present"><i class="fas fa-check-circle"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= stats.present %></span>
          <span class="stat-label">Hadir</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-absent"><i class="fas fa-times-circle"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= stats.absent %></span>
          <span class="stat-label">Tidak Hadir</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-rate"><i class="fas fa-chart-pie"></i></div>
        <div class="stat-info">
          <span class="stat-value"><%= stats.attendanceRate %>%</span>
          <span class="stat-label">Kehadiran</span>
        </div>
      </div>
    </div>

    <!-- Progress bar -->
    <div class="section-card">
      <div class="progress-label">
        <span>Tingkat Kehadiran</span>
        <strong><%= stats.attendanceRate %>%</strong>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" style="width: <%= stats.attendanceRate %>%"></div>
      </div>
    </div>

    <!-- Presence list -->
    <div class="section-card">
      <h3 class="section-title">Riwayat Kehadiran</h3>
      <% if (presences.length === 0) { %>
        <div class="empty-state"><i class="fas fa-calendar-times"></i><p>Belum ada data presensi.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Tanggal</th>
                <th>Sesi</th>
                <th>Program</th>
                <th>Waktu</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% presences.forEach(p => { %>
              <tr>
                <td><%= formatDate(p.date) %></td>
                <td><%= p.schedule_title %></td>
                <td><%= p.program_name %></td>
                <td><%= formatTime(p.start_time) %> - <%= formatTime(p.end_time) %></td>
                <td>
                  <span class="presence-pill presence-<%= p.status %>">
                    <%= p.status === 'present' ? 'Hadir' : p.status === 'late' ? 'Terlambat' : p.status === 'excused' ? 'Izin' : 'Tidak Hadir' %>
                  </span>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
