<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/member" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Presensi Kelas</h1>
  </div>

  <%
    const uploadSessions = schedules || [];
  %>

  <div class="container">
    <form action="/member/presence" method="POST" enctype="multipart/form-data" class="modal-form" id="presenceForm">
      <input type="hidden" name="tutor_id" id="presenceTutorId">

      <div class="section-card presence-session-card">
        <div class="presence-session-head">
          <h3 class="section-title"><i class="fas fa-magnifying-glass"></i> Pilih Sesi</h3>
          <span class="presence-session-count"><i class="fas fa-calendar-check"></i> <%= uploadSessions.length %> sesi</span>
        </div>

        <div class="form-group">
          <label class="presence-session-label"><i class="fas fa-list"></i> Ganti sesi presensi</label>
          <select name="schedule_id" id="presenceSchedule" class="form-input presence-session-select" required <%= uploadSessions.length === 0 ? 'disabled' : '' %>>
            <option value="">Pilih sesi yang akan diisi presensinya</option>
            <% uploadSessions.forEach(s => { %>
              <option value="<%= s.id %>"
                      data-tutor-id="<%= s.tutor_id %>"
                      data-program-id="<%= s.program_id %>"
                      data-period-start="<%= s.period_start %>"
                      data-meeting="<%= s.meeting_number_guess %>"
                      data-submitted="<%= s.submission_id ? '1' : '' %>">
                <%= formatDate(s.date) %> | <%= formatTime(s.start_time) %>-<%= formatTime(s.end_time) %> | <%= s.program_name %> | <%= s.tutor_name %><%= s.submission_id ? ' | Sudah terkirim' : '' %>
              </option>
            <% }) %>
          </select>
          <p class="field-hint">Jika presensi sesi ini sudah pernah dikirim, submit ulang akan memperbarui bukti presensi lama.</p>
        </div>

        <div id="presenceSelectedSession" class="presence-selected-session" style="display:none">
          <div class="presence-date-tile">
            <strong id="selectedSessionDay">--</strong>
            <span id="selectedSessionMonth">--</span>
          </div>
          <div class="presence-selected-body">
            <div class="presence-selected-title">
              <h4 id="selectedSessionProgram">Pilih sesi</h4>
              <span class="badge-pill badge-upcoming" id="selectedSessionMeeting">Meeting</span>
            </div>
            <div class="presence-selected-meta">
              <span><i class="fas fa-chalkboard-teacher"></i> <b id="selectedSessionTutor">-</b></span>
              <span><i class="fas fa-clock"></i> <b id="selectedSessionTime">-</b></span>
            </div>
          </div>
        </div>

        <% if (uploadSessions.length === 0) { %>
          <div class="empty-state compact"><i class="fas fa-calendar-xmark"></i><p>Belum ada sesi untuk presensi.</p></div>
        <% } %>
      </div>

      <div class="section-card">
        <h3 class="section-title"><i class="fas fa-camera"></i> Upload Bukti Presensi</h3>

        <div class="form-group">
          <label class="form-label">Full Name <span class="req">*</span></label>
          <input type="text" class="form-input ff-read-only" value="<%= user.name %>" readonly>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Program <span class="req">*</span></label>
            <select name="program_id" id="presenceProgram" class="form-input" required <%= uploadSessions.length === 0 ? 'disabled' : '' %>>
              <option value="">- Select -</option>
              <% programs.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Study Period <span class="req">*</span></label>
            <select name="period_start" id="presencePeriod" class="form-input" required <%= uploadSessions.length === 0 ? 'disabled' : '' %>>
              <option value="">- Select -</option>
              <% periods.forEach(p => { %><option value="<%= p.value %>"><%= p.label %></option><% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Meeting <span class="req">*</span></label>
          <select name="meeting_number" id="presenceMeeting" class="form-input" required <%= uploadSessions.length === 0 ? 'disabled' : '' %>>
            <option value="">- Select -</option>
            <% meetings.forEach(m => { %><option value="<%= m %>"><%= m %></option><% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Class Screenshot <span class="req">*</span></label>
          <input type="file" name="class_screenshot" class="form-input" accept="image/*" required <%= uploadSessions.length === 0 ? 'disabled' : '' %>>
          <p class="field-hint">Unggah screenshot kelas (JPG/PNG/WEBP, maks. 5MB) sebagai bukti kehadiran.</p>
        </div>

        <button type="submit" class="btn btn-primary btn-full" <%= uploadSessions.length === 0 ? 'disabled' : '' %>><i class="fas fa-paper-plane"></i> Submit</button>
      </div>
    </form>

    <div class="section-card">
      <div class="presence-history-head">
        <h3 class="section-title"><i class="fas fa-clock-rotate-left"></i> Riwayat Presensi Saya</h3>
        <span class="presence-session-count"><i class="fas fa-list-check"></i> <%= submissions.length %> presensi</span>
      </div>
      <% if (submissions.length === 0) { %>
        <div class="empty-state"><i class="fas fa-user-check"></i><p>Belum ada presensi terkirim.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table presence-history-table">
            <thead>
              <tr><th>Dikirim</th><th>Program &amp; Periode</th><th>Tutor</th><th>Pertemuan</th><th>Bukti</th></tr>
            </thead>
            <tbody>
              <% submissions.forEach(s => { %>
              <tr>
                <td data-label="Dikirim">
                  <div class="ph-date">
                    <strong><%= formatDate(s.created_at) %></strong>
                    <small><i class="far fa-clock"></i> <%= new Date(s.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</small>
                  </div>
                </td>
                <td data-label="Program">
                  <div class="ph-program">
                    <strong><%= s.program_name || '-' %></strong>
                    <small><i class="far fa-calendar"></i> <%= s.period_label %></small>
                  </div>
                </td>
                <td data-label="Tutor">
                  <div class="ph-tutor">
                    <span class="table-avatar-init sm"><%= getInitials(s.tutor_name || '-') %></span>
                    <span><%= s.tutor_name || '-' %></span>
                  </div>
                </td>
                <td data-label="Pertemuan"><span class="ph-meeting"><i class="fas fa-hashtag"></i> Pertemuan <b><%= s.meeting_number %></b></span></td>
                <td data-label="Bukti">
                  <% if (s.screenshot) { %>
                    <a href="<%= s.screenshot %>" target="_blank" rel="noopener" class="ph-proof">
                      <img src="<%= s.screenshot %>" alt="bukti">
                      <span><i class="fas fa-up-right-from-square"></i> Lihat</span>
                    </a>
                  <% } else { %>
                    <span class="ph-noproof"><i class="fas fa-image"></i> Tanpa bukti</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
(() => {
  const schedule = document.getElementById('presenceSchedule');
  if (!schedule) return;

  const tutor = document.getElementById('presenceTutorId');
  const program = document.getElementById('presenceProgram');
  const period = document.getElementById('presencePeriod');
  const meeting = document.getElementById('presenceMeeting');
  const panel = document.getElementById('presenceSelectedSession');
  const day = document.getElementById('selectedSessionDay');
  const month = document.getElementById('selectedSessionMonth');
  const title = document.getElementById('selectedSessionProgram');
  const sessionTutor = document.getElementById('selectedSessionTutor');
  const time = document.getElementById('selectedSessionTime');
  const sessionMeeting = document.getElementById('selectedSessionMeeting');

  const parseLabel = (label) => {
    const parts = String(label || '').split('|').map((part) => part.trim());
    return {
      date: parts[0] || '-',
      time: parts[1] || '-',
      program: parts[2] || '-',
      tutor: parts[3] || '-',
    };
  };

  const updateFields = () => {
    const option = schedule.options[schedule.selectedIndex];
    if (!option || !option.value) {
      tutor.value = '';
      program.value = '';
      period.value = '';
      meeting.value = '';
      panel.style.display = 'none';
      return;
    }

    tutor.value = option.dataset.tutorId || '';
    program.value = option.dataset.programId || '';
    period.value = option.dataset.periodStart || '';
    meeting.value = option.dataset.meeting || '';

    const label = parseLabel(option.textContent);
    const dateParts = label.date.split(' ');
    day.textContent = dateParts[0] || '--';
    month.textContent = dateParts.slice(1).join(' ') || '--';
    title.textContent = label.program;
    sessionTutor.textContent = label.tutor;
    time.textContent = label.time;
    sessionMeeting.textContent = meeting.value ? `Meeting ${meeting.value}` : 'Meeting';
    panel.style.display = 'flex';
  };

  schedule.addEventListener('change', updateFields);
})();
</script>

<%- include('../partials/footer') %>
