<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/member" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Presensi Kelas</h1>
    <p class="sub-banner-desc">Check-in jadwal kelas dan kirim bukti kehadiran dari satu halaman.</p>
  </div>

  <div class="container">
    <div class="section-card">
      <div class="presence-header">
        <div>
          <h3>Presensi Jadwal</h3>
          <p>Member bisa check-in saat sesi dibuka. Tutor tetap dapat memperbarui status dari halaman tutor.</p>
        </div>
        <span class="presence-session-count"><i class="fas fa-calendar-check"></i> <%= presenceStats.total %> sesi</span>
      </div>

      <div class="presence-summary">
        <span class="ps-chip ps-present"><i class="fas fa-check"></i> Hadir: <strong><%= presenceStats.present %></strong></span>
        <span class="ps-chip ps-late"><i class="fas fa-clock"></i> Terlambat: <strong><%= presenceStats.late %></strong></span>
        <span class="ps-chip ps-excused"><i class="fas fa-envelope"></i> Izin: <strong><%= presenceStats.excused %></strong></span>
        <span class="ps-chip ps-absent"><i class="fas fa-xmark"></i> Absen: <strong><%= presenceStats.absent %></strong></span>
      </div>

      <% if (schedules.length === 0) { %>
        <div class="empty-state compact"><i class="fas fa-calendar-xmark"></i><p>Belum ada jadwal untuk presensi.</p></div>
      <% } else { %>
        <div class="schedule-cards presence-checkin-list">
          <% schedules.forEach(s => { %>
            <div class="sched-card <%= s.status %>">
              <div class="sched-card-header">
                <div class="sched-date">
                  <span class="sched-day"><%= new Date(s.date).toLocaleDateString('id-ID', {day:'2-digit'}) %></span>
                  <span class="sched-month"><%= new Date(s.date).toLocaleDateString('id-ID', {month:'short', year:'numeric'}) %></span>
                </div>
                <div class="sched-status-badge">
                  <% if (s.status === 'completed') { %>
                    <span class="badge-pill badge-completed"><i class="fas fa-check"></i> Selesai</span>
                  <% } else if (s.status === 'upcoming') { %>
                    <span class="badge-pill badge-upcoming"><i class="fas fa-clock"></i> Akan Datang</span>
                  <% } else if (s.status === 'cancelled') { %>
                    <span class="badge-pill badge-cancelled"><i class="fas fa-times"></i> Dibatalkan</span>
                  <% } %>
                </div>
              </div>
              <div class="sched-body">
                <h3 class="sched-title"><%= s.title %></h3>
                <div class="sched-meta">
                  <span><i class="fas fa-book"></i> <%= s.program_name %></span>
                  <span><i class="fas fa-chalkboard-teacher"></i> <%= s.tutor_name %></span>
                  <span><i class="fas fa-clock"></i> <%= formatTime(s.start_time) %> - <%= formatTime(s.end_time) %></span>
                </div>
              </div>
              <div class="sched-footer">
                <span class="presence-pill presence-<%= s.presence_status %>">
                  <i class="fas fa-<%= s.presence_status === 'present' ? 'check' : s.presence_status === 'late' ? 'clock' : s.presence_status === 'excused' ? 'envelope' : 'times' %>"></i>
                  <%= s.presence_status === 'present' ? 'Hadir' : s.presence_status === 'late' ? 'Terlambat' : s.presence_status === 'excused' ? 'Izin' : 'Belum Hadir' %>
                </span>
                <% if (s.can_check_in) { %>
                  <form action="/member/presence/<%= s.id %>/check-in" method="POST" style="display:inline">
                    <button class="btn btn-sm btn-primary"><i class="fas fa-user-check"></i> Check-in</button>
                  </form>
                <% } %>
                <% if (s.check_in_time) { %>
                  <span class="table-subtext"><i class="fas fa-clock"></i> <%= new Date(s.check_in_time).toLocaleString('id-ID', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) %></span>
                <% } %>
              </div>

              <details class="sched-proofs"<%= (s.class_proofs && s.class_proofs.length) ? ' open' : '' %>>
                <summary>
                  <span><i class="fas fa-camera-retro"></i> Foto Kelas</span>
                  <span class="sched-proofs-count"><%= (s.class_proofs || []).length %></span>
                </summary>
                <% (s.class_proof_groups || []).forEach(g => { %>
                  <div class="cp-meeting-group">
                    <div class="cp-meeting-head">
                      <span class="cp-meeting-label">
                        <i class="fas fa-<%= g.meeting ? 'hashtag' : 'folder-open' %>"></i>
                        <%= g.meeting ? 'Pertemuan ' + g.meeting : 'Tanpa nomor pertemuan' %>
                      </span>
                      <span class="cp-meeting-count"><%= g.items.length %> foto</span>
                    </div>
                    <div class="class-proof-gallery compact">
                      <% g.items.forEach(cp => { %>
                        <figure class="class-proof-item">
                          <a href="<%= cp.image %>" target="_blank" rel="noopener">
                            <img src="<%= cp.image %>" alt="<%= cp.caption || 'Foto kelas' %>" loading="lazy">
                          </a>
                          <figcaption>
                            <span class="cp-meta">
                              <b><%= cp.caption || 'Foto kelas' %></b>
                              <small>
                                <i class="fas fa-<%= cp.uploader_role === 'member' ? 'user-graduate' : 'chalkboard-teacher' %>"></i>
                                <%= cp.uploader_name || (cp.uploader_role === 'member' ? 'Member' : 'Tutor') %>
                              </small>
                            </span>
                            <% if (cp.uploaded_by == user.id) { %>
                              <form action="/member/presence/class-proof/<%= cp.id %>/delete" method="POST" onsubmit="return confirm('Hapus foto ini?')">
                                <button class="cp-del" title="Hapus"><i class="fas fa-trash"></i></button>
                              </form>
                            <% } %>
                          </figcaption>
                        </figure>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
                <form action="/member/presence/<%= s.id %>/class-proof" method="POST" enctype="multipart/form-data" class="sched-proof-form">
                  <label class="sched-proof-file">
                    <i class="fas fa-cloud-arrow-up"></i> <span>Pilih gambar</span>
                    <input type="file" name="class_photo" accept="image/*" required onchange="this.closest('form').querySelector('.sched-proof-name').textContent = (this.files[0] ? this.files[0].name : '');">
                  </label>
                  <span class="sched-proof-name"></span>
                  <select name="meeting_number" class="form-input cp-meeting-select" required title="Foto ini untuk pertemuan ke berapa?">
                    <option value="">Pertemuan ke-</option>
                    <% meetings.forEach(n => { %><option value="<%= n %>">Pertemuan <%= n %></option><% }) %>
                  </select>
                  <input type="text" name="caption" class="form-input" maxlength="255" placeholder="Keterangan (opsional)">
                  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-upload"></i> Unggah</button>
                </form>
              </details>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Submission form -->
    <div class="section-card">
      <h3 class="section-title"><i class="fas fa-camera"></i> Upload Bukti Presensi</h3>
      <form action="/member/presence" method="POST" enctype="multipart/form-data" class="modal-form" id="presenceForm">
        <div class="form-group">
          <label class="form-label">Full Name <span class="req">*</span></label>
          <input type="text" class="form-input ff-read-only" value="<%= user.name %>" readonly>
        </div>

        <div class="form-group">
          <label class="form-label">Choose The Tutor <span class="req">*</span></label>
          <select name="tutor_id" class="form-input" required>
            <option value="">- Select -</option>
            <% tutors.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Study Period <span class="req">*</span></label>
          <select name="period_start" class="form-input" required>
            <option value="">- Select -</option>
            <% periods.forEach(p => { %><option value="<%= p.value %>"><%= p.label %></option><% }) %>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Program <span class="req">*</span></label>
            <select name="program_id" class="form-input" required>
              <option value="">- Select -</option>
              <% programs.forEach(p => { %><option value="<%= p.id %>" <%= programs.length === 1 ? 'selected' : '' %>><%= p.name %></option><% }) %>
            </select>
            <% if (programs.length === 0) { %>
              <small class="field-hint">Belum ada program terdaftar. Hubungi admin bila kelasmu belum muncul.</small>
            <% } else { %>
              <small class="field-hint">Sesuai program pendaftaranmu.</small>
            <% } %>
          </div>
          <div class="form-group">
            <label class="form-label">Meeting <span class="req">*</span></label>
            <select name="meeting_number" class="form-input" required>
              <option value="">- Select -</option>
              <% meetings.forEach(m => { %><option value="<%= m %>"><%= m %></option><% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Class Screenshot <span class="req">*</span></label>
          <input type="file" name="class_screenshot" class="form-input" accept="image/*" required>
          <p class="field-hint">Unggah screenshot kelas (JPG/PNG/WEBP, maks. 5MB) sebagai bukti kehadiran.</p>
        </div>

        <button type="submit" class="btn btn-primary btn-full"><i class="fas fa-paper-plane"></i> Submit</button>
      </form>
    </div>

    <!-- History -->
    <div class="section-card">
      <div class="presence-history-head">
        <h3 class="section-title"><i class="fas fa-clock-rotate-left"></i> Riwayat Presensi Saya</h3>
        <span class="presence-session-count"><i class="fas fa-list-check"></i> <%= submissions.length %> presensi</span>
      </div>
      <% if (submissions.length === 0) { %>
        <div class="empty-state"><i class="fas fa-user-check"></i><p>Belum ada presensi terkirim.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table presence-history-table">
            <thead>
              <tr><th>Dikirim</th><th>Program &amp; Periode</th><th>Tutor</th><th>Pertemuan</th><th>Bukti</th></tr>
            </thead>
            <tbody>
              <% submissions.forEach(s => { %>
              <tr>
                <td data-label="Dikirim">
                  <div class="ph-date">
                    <strong><%= formatDate(s.created_at) %></strong>
                    <small><i class="far fa-clock"></i> <%= new Date(s.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</small>
                  </div>
                </td>
                <td data-label="Program">
                  <div class="ph-program">
                    <strong><%= s.program_name || '-' %></strong>
                    <small><i class="far fa-calendar"></i> <%= s.period_label %></small>
                  </div>
                </td>
                <td data-label="Tutor">
                  <div class="ph-tutor">
                    <span class="table-avatar-init sm"><%= getInitials(s.tutor_name || '-') %></span>
                    <span><%= s.tutor_name || '-' %></span>
                  </div>
                </td>
                <td data-label="Pertemuan"><span class="ph-meeting"><i class="fas fa-hashtag"></i> Pertemuan <b><%= s.meeting_number %></b></span></td>
                <td data-label="Bukti">
                  <% if (s.screenshot) { %>
                    <a href="<%= s.screenshot %>" target="_blank" rel="noopener" class="ph-proof">
                      <img src="<%= s.screenshot %>" alt="bukti">
                      <span><i class="fas fa-up-right-from-square"></i> Lihat</span>
                    </a>
                  <% } else { %>
                    <span class="ph-noproof"><i class="fas fa-image"></i> Tanpa bukti</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
