<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<%
  const bySection = { listening: [], structure: [], reading: [] };
  questions.forEach(q => { (bySection[q.section] || (bySection[q.section] = [])).push(q); });
  const passagesBy = { listening: [], reading: [] };
  passages.forEach(p => { (passagesBy[p.section] || (passagesBy[p.section] = [])).push(p); });
  const qOfPassage = (sec, pid) => bySection[sec].filter(q => String(q.passage_id) === String(pid));
  const qNoPassage = (sec) => bySection[sec].filter(q => !q.passage_id);
  function optionRow(q, letter, text) {
    if (!text) return '';
    return `<label class="toefl-opt"><input type="radio" name="answers[q${q.id}]" value="${letter}"><span class="toefl-opt-let">${letter}</span><span>${text.replace(/</g,'&lt;')}</span></label>`;
  }
%>

<div class="page-wrapper toefl-take-wrap">
  <div class="toefl-topbar">
    <div class="toefl-topbar-title"><i class="fas fa-trophy"></i> <%= sim.title %></div>
    <div class="toefl-timer" id="toeflTimer">--:--</div>
    <div class="toefl-step" id="toeflStep">Section 1/3</div>
  </div>

  <form action="/member/toefl/<%= sim.id %>/submit" method="POST" id="toeflForm">
    <div class="container">

      <!-- LISTENING -->
      <section class="toefl-section" data-section="listening" data-minutes="<%= sim.listening_minutes || 35 %>">
        <div class="section-card">
          <h3 class="section-title"><i class="fas fa-headphones"></i> Section 1 — Listening Comprehension</h3>
          <p class="module-materials-note">Putar audio tiap Part, lalu jawab. Audio bisa diputar sesuai kebutuhan latihan.</p>
        </div>
        <% passagesBy.listening.forEach(p => { %>
          <div class="section-card">
            <h4><i class="fas fa-music"></i> <%= p.label || 'Part' %></h4>
            <% if (p.audio_url) { %><audio controls preload="none" class="toefl-audio" src="<%= p.audio_url %>"></audio><% } %>
            <% if (p.body) { %><p class="toefl-directions"><%= p.body %></p><% } %>
            <% qOfPassage('listening', p.id).forEach(q => { %>
              <div class="toefl-q">
                <div class="toefl-q-head"><b><%= q.number || '' %>.</b> <%= q.prompt || '' %></div>
                <div class="toefl-opts">
                  <%- optionRow(q,'A',q.option_a) %><%- optionRow(q,'B',q.option_b) %><%- optionRow(q,'C',q.option_c) %><%- optionRow(q,'D',q.option_d) %>
                </div>
              </div>
            <% }) %>
          </div>
        <% }) %>
        <% if (qNoPassage('listening').length) { %>
          <div class="section-card">
            <% qNoPassage('listening').forEach(q => { %>
              <div class="toefl-q"><div class="toefl-q-head"><b><%= q.number || '' %>.</b> <%= q.prompt || '' %></div>
                <div class="toefl-opts"><%- optionRow(q,'A',q.option_a) %><%- optionRow(q,'B',q.option_b) %><%- optionRow(q,'C',q.option_c) %><%- optionRow(q,'D',q.option_d) %></div></div>
            <% }) %>
          </div>
        <% } %>
        <div class="toefl-nav"><button type="button" class="btn btn-primary" data-next>Lanjut ke Structure <i class="fas fa-arrow-right"></i></button></div>
      </section>

      <!-- STRUCTURE -->
      <section class="toefl-section" data-section="structure" data-minutes="<%= sim.structure_minutes || 25 %>" hidden>
        <div class="section-card">
          <h3 class="section-title"><i class="fas fa-spell-check"></i> Section 2 — Structure &amp; Written Expression</h3>
        </div>
        <div class="section-card">
          <% bySection.structure.forEach(q => { %>
            <div class="toefl-q"><div class="toefl-q-head"><b><%= q.number || '' %>.</b> <%= q.prompt || '' %></div>
              <div class="toefl-opts"><%- optionRow(q,'A',q.option_a) %><%- optionRow(q,'B',q.option_b) %><%- optionRow(q,'C',q.option_c) %><%- optionRow(q,'D',q.option_d) %></div></div>
          <% }) %>
        </div>
        <div class="toefl-nav"><button type="button" class="btn btn-primary" data-next>Lanjut ke Reading <i class="fas fa-arrow-right"></i></button></div>
      </section>

      <!-- READING -->
      <section class="toefl-section" data-section="reading" data-minutes="<%= sim.reading_minutes || 55 %>" hidden>
        <div class="section-card">
          <h3 class="section-title"><i class="fas fa-book-open"></i> Section 3 — Reading Comprehension</h3>
        </div>
        <% passagesBy.reading.forEach(p => { %>
          <div class="section-card toefl-reading-block">
            <% if (p.body) { %><div class="toefl-passage"><h4><%= p.label || 'Passage' %></h4><p><%= p.body %></p></div><% } %>
            <div class="toefl-passage-q">
              <% qOfPassage('reading', p.id).forEach(q => { %>
                <div class="toefl-q"><div class="toefl-q-head"><b><%= q.number || '' %>.</b> <%= q.prompt || '' %></div>
                  <div class="toefl-opts"><%- optionRow(q,'A',q.option_a) %><%- optionRow(q,'B',q.option_b) %><%- optionRow(q,'C',q.option_c) %><%- optionRow(q,'D',q.option_d) %></div></div>
              <% }) %>
            </div>
          </div>
        <% }) %>
        <% if (qNoPassage('reading').length) { %>
          <div class="section-card"><% qNoPassage('reading').forEach(q => { %>
            <div class="toefl-q"><div class="toefl-q-head"><b><%= q.number || '' %>.</b> <%= q.prompt || '' %></div>
              <div class="toefl-opts"><%- optionRow(q,'A',q.option_a) %><%- optionRow(q,'B',q.option_b) %><%- optionRow(q,'C',q.option_c) %><%- optionRow(q,'D',q.option_d) %></div></div>
          <% }) %></div>
        <% } %>
        <div class="toefl-nav"><button type="submit" class="btn btn-primary btn-lg" id="toeflFinish"><i class="fas fa-flag-checkered"></i> Selesai &amp; Lihat Skor</button></div>
      </section>

    </div>
  </form>
</div>

<script>
(function () {
  const sections = Array.prototype.slice.call(document.querySelectorAll('.toefl-section'));
  const timerEl = document.getElementById('toeflTimer');
  const stepEl = document.getElementById('toeflStep');
  let idx = 0, remaining = 0, ticker = null;

  function showSection(i) {
    sections.forEach((s, k) => { s.hidden = k !== i; });
    stepEl.textContent = 'Section ' + (i + 1) + '/' + sections.length;
    window.scrollTo(0, 0);
    startTimer(parseInt(sections[i].dataset.minutes, 10) || 25);
  }
  function fmt(s) { const m = Math.floor(s / 60), ss = s % 60; return (m < 10 ? '0' : '') + m + ':' + (ss < 10 ? '0' : '') + ss; }
  function startTimer(minutes) {
    clearInterval(ticker);
    remaining = minutes * 60;
    timerEl.textContent = fmt(remaining);
    ticker = setInterval(function () {
      remaining -= 1;
      timerEl.textContent = fmt(Math.max(0, remaining));
      timerEl.classList.toggle('is-low', remaining <= 60);
      if (remaining <= 0) { clearInterval(ticker); nextSection(true); }
    }, 1000);
  }
  function nextSection(auto) {
    if (idx < sections.length - 1) { idx += 1; showSection(idx); }
    else if (auto) { clearInterval(ticker); document.getElementById('toeflForm').submit(); }
  }
  sections.forEach(function (s) {
    const btn = s.querySelector('[data-next]');
    if (btn) btn.addEventListener('click', function () { nextSection(false); });
  });
  document.getElementById('toeflForm').addEventListener('submit', function () { clearInterval(ticker); });
  showSection(0);
})();
</script>

<%- include('../partials/footer') %>
