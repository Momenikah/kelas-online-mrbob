<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/member" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Jadwal Kelas</h1>
  </div>

  <div class="container">
    <% if (schedules.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-calendar-times"></i>
        <p>Belum ada jadwal kelas.</p>
      </div>
    <% } else { %>
      <div class="schedule-cards">
        <% schedules.forEach(s => { %>
        <div class="sched-card <%= s.status %>">
          <div class="sched-card-header">
            <div class="sched-date">
              <span class="sched-day"><%= new Date(s.date).toLocaleDateString('id-ID', {day:'2-digit'}) %></span>
              <span class="sched-month"><%= new Date(s.date).toLocaleDateString('id-ID', {month:'short', year:'numeric'}) %></span>
            </div>
            <div class="sched-status-badge">
              <% if (s.status === 'completed') { %>
                <span class="badge-pill badge-completed"><i class="fas fa-check"></i> Selesai</span>
              <% } else if (s.status === 'upcoming') { %>
                <span class="badge-pill badge-upcoming"><i class="fas fa-clock"></i> Akan Datang</span>
              <% } else if (s.status === 'cancelled') { %>
                <span class="badge-pill badge-cancelled"><i class="fas fa-times"></i> Dibatalkan</span>
              <% } %>
            </div>
          </div>
          <div class="sched-body">
            <h3 class="sched-title"><%= s.title %></h3>
            <div class="sched-meta">
              <span><i class="fas fa-book"></i> <%= s.program_name %></span>
              <span><i class="fas fa-chalkboard-teacher"></i> <%= s.tutor_name %></span>
              <span><i class="fas fa-clock"></i> <%= formatTime(s.start_time) %> - <%= formatTime(s.end_time) %></span>
              <% if (s.location) { %><span><i class="fas fa-map-marker-alt"></i> <%= s.location %></span><% } %>
            </div>
            <% if (s.description) { %><p class="sched-desc"><%= s.description %></p><% } %>
          </div>
          <div class="sched-footer">
            <% if (s.presence_status) { %>
              <span class="presence-pill presence-<%= s.presence_status %>">
                <i class="fas fa-<%= s.presence_status === 'present' ? 'check' : s.presence_status === 'late' ? 'clock' : 'times' %>"></i>
                <%= s.presence_status === 'present' ? 'Hadir' : s.presence_status === 'late' ? 'Terlambat' : s.presence_status === 'excused' ? 'Izin' : 'Tidak Hadir' %>
              </span>
            <% } %>
            <% if (s.meeting_link && s.status === 'upcoming') { %>
              <a href="<%= s.meeting_link %>" target="_blank" class="btn btn-sm btn-primary">
                <i class="fas fa-video"></i> Join Meeting
              </a>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
