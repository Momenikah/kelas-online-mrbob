<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/member" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <div class="sub-banner-titles">
      <h1>Schedule</h1>
      <p class="sub-banner-sub"><%= user.name %></p>
    </div>
  </div>

  <div class="container">
    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-icon stat-icon-total"><i class="fas fa-calendar-alt"></i></div>
        <div class="stat-info"><span class="stat-value"><%= stats.total %></span><span class="stat-label">Total Sesi</span></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-rate"><i class="fas fa-clock"></i></div>
        <div class="stat-info"><span class="stat-value"><%= stats.upcoming %></span><span class="stat-label">Akan Datang</span></div>
      </div>
      <div class="stat-card">
        <div class="stat-icon stat-icon-present"><i class="fas fa-check-double"></i></div>
        <div class="stat-info"><span class="stat-value"><%= stats.completed %></span><span class="stat-label">Selesai</span></div>
      </div>
    </div>

    <div class="section-card">
      <div class="schedule-toolbar">
        <p class="schedule-filter-note schedule-filter-note--flat"><i class="fas fa-circle-info"></i> Kehadiran per sesi diisi di halaman <a href="/member/presence">Presensi</a>.</p>
        <form method="GET" action="/member/schedule" class="schedule-filter schedule-filter-inline">
          <div class="schedule-filter-field">
            <label><i class="far fa-calendar-alt"></i> Periode</label>
            <select name="period" class="form-input" onchange="this.form.submit()">
              <option value="">All</option>
              <% periods.forEach(p => { %>
                <option value="<%= p.value %>" <%= filters.period === p.value ? 'selected' : '' %>><%= p.label %></option>
              <% }) %>
            </select>
          </div>
          <% if (filters.period) { %>
            <a href="/member/schedule" class="btn btn-outline schedule-filter-reset"><i class="fas fa-rotate-left"></i> Reset</a>
          <% } %>
        </form>
      </div>

      <%
        // Flatten period-groups into one row per session (table like the reference).
        const rows = [];
        periodGroups.forEach(g => {
          (g.sessions || []).forEach(s => rows.push({ g, s }));
        });
        rows.sort((a, b) => (String(a.s.date) < String(b.s.date) ? -1 : 1));
      %>

      <% if (rows.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-calendar-times"></i>
          <p>Tidak ada jadwal pada periode ini.</p>
        </div>
      <% } else { %>
      <div class="jadwal-table-wrap">
        <table class="jadwal-table">
          <thead>
            <tr>
              <th>Nama Lengkap</th>
              <th>Kategori</th>
              <th>Paket</th>
              <th>Program</th>
              <th>Periode</th>
              <th>Durasi</th>
              <th>Jam Belajar</th>
              <th>Tutor</th>
              <th>Zoom Room</th>
              <th>Link Zoom</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(({ g, s }) => {
                 const isCancelled = s.status === 'cancelled';
                 const past = String(s.date) < new Date().toISOString().slice(0, 10);
                 const attended = s.presence_status === 'present' || s.presence_status === 'late';
            %>
            <tr class="<%= isCancelled ? 'is-cancelled' : (past ? 'is-past' : 'is-upcoming') %>">
              <td data-label="Nama Lengkap" class="jt-name">
                <span><%= user.name %></span>
                <% if (isCancelled) { %>
                  <span class="jt-badge jt-badge-cancel">Dibatalkan</span>
                <% } else if (past) { %>
                  <span class="jt-badge <%= attended ? 'jt-badge-ok' : 'jt-badge-warn' %>"><%= attended ? 'Hadir' : 'Tidak Hadir' %></span>
                <% } else { %>
                  <span class="jt-badge jt-badge-next">Akan Datang</span>
                <% } %>
              </td>
              <td data-label="Kategori"><%= g.kategori %></td>
              <td data-label="Paket"><%= g.paket %></td>
              <td data-label="Program"><%= s.program_name || '-' %></td>
              <td data-label="Periode" class="jt-nowrap"><%= formatDate(s.date) %></td>
              <td data-label="Durasi" class="jt-nowrap"><%= g.durasi %></td>
              <td data-label="Jam Belajar" class="jt-nowrap"><%= formatTime(s.start_time) %> - <%= formatTime(s.end_time) %> WIB</td>
              <td data-label="Tutor"><%= s.tutor_name || '-' %></td>
              <td data-label="Zoom Room"><%= s.location || '-' %></td>
              <td data-label="Link Zoom" class="jt-actions-cell">
                <div class="jt-actions">
                  <% if (s.meeting_link) { %>
                    <a href="<%= s.meeting_link %>" target="_blank" rel="noopener" class="btn btn-zoom btn-sm"><i class="fas fa-video"></i> Link ZOOM</a>
                  <% } else { %>
                    <span class="jt-muted">-</span>
                  <% } %>
                  <% if (s.tutor_phone) {
                       let wp = String(s.tutor_phone).replace(/\D/g, '');
                       if (wp.startsWith('0')) wp = '62' + wp.slice(1);
                       else if (wp.startsWith('8')) wp = '62' + wp;
                       const waText = encodeURIComponent([
                         `Halo Kak ${s.tutor_name || ''}, saya ${user.name} peserta kelas ${s.program_name || ''}.`,
                         `Ingin menanyakan jadwal ${formatDate(s.date)} (${formatTime(s.start_time)} - ${formatTime(s.end_time)} WIB).`
                       ].join('\n'));
                       const waHref = wp ? `https://wa.me/${wp}?text=${waText}` : '';
                  %>
                    <% if (waHref) { %>
                    <a href="<%= waHref %>" target="_blank" rel="noopener" class="btn btn-wa btn-sm"><i class="fab fa-whatsapp"></i> WhatsApp</a>
                    <% } %>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
