<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'member' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>
  <div class="sub-banner">
    <a href="/member" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Laporan Member</h1>
    <p class="sub-banner-desc">Report diisi oleh tutor. Member hanya dapat melihat perkembangan Day 1-15.</p>
  </div>

  <div class="container">
    <div class="section-card">
      <h3 class="section-title"><i class="fas fa-file-lines"></i> Member Report</h3>
      <% if (periodOptions && periodOptions.length > 0) { %>
        <form method="GET" action="/member/report" class="filter-form">
          <select name="period" class="form-input" onchange="this.form.submit()">
            <option value="">Semua Periode</option>
            <% periodOptions.forEach(opt => { %>
              <option value="<%= opt.period_value %>" <%= filters.period === opt.period_value ? 'selected' : '' %>><%= opt.label || formatDate(opt.period_value) %></option>
            <% }) %>
          </select>
          <% if (filters.period) { %><a href="/member/report" class="btn btn-outline">Reset</a><% } %>
        </form>
      <% } %>
      <% if (reports.length === 0) { %>
        <div class="empty-state compact"><i class="fas fa-file-lines"></i><p><%= filters.period ? 'Tidak ada report pada periode ini.' : 'Belum ada report dari tutor.' %></p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table">
            <thead><tr><th>Periode</th><th>Program</th><th>Tutor</th><th>Paket</th><th>Update</th><th></th></tr></thead>
            <tbody>
              <% reports.forEach(r => { %>
                <tr>
                  <td><%= formatDate(r.period_start) %></td>
                  <td><%= r.program_name %></td>
                  <td><%= r.tutor_name %></td>
                  <td><%= r.package_name || '-' %></td>
                  <td><%= formatDate(r.updated_at) %></td>
                  <td><a href="/member/report/<%= r.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i> View Report</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <% presStats.forEach(stat => { %>
    <div class="section-card">
      <h3 class="section-title"><i class="fas fa-graduation-cap"></i> <%= stat.program_name %></h3>
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-icon"><i class="fas fa-calendar-alt"></i></div>
          <div class="stat-info">
            <span class="stat-value"><%= stat.total_schedules %></span>
            <span class="stat-label">Total Sesi</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon stat-icon-present"><i class="fas fa-check-circle"></i></div>
          <div class="stat-info">
            <span class="stat-value"><%= stat.present_count %></span>
            <span class="stat-label">Hadir</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon stat-icon-absent"><i class="fas fa-times-circle"></i></div>
          <div class="stat-info">
            <span class="stat-value"><%= parseInt(stat.total_schedules) - parseInt(stat.present_count) - parseInt(stat.late_count) %></span>
            <span class="stat-label">Tidak Hadir</span>
          </div>
        </div>
      </div>
      <div class="progress-label">
        <span>Tingkat Kehadiran</span>
        <strong><%= stat.total_schedules > 0 ? Math.round((parseInt(stat.present_count)+parseInt(stat.late_count)) / parseInt(stat.total_schedules) * 100) : 0 %>%</strong>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" style="width: <%= stat.total_schedules > 0 ? Math.round((parseInt(stat.present_count)+parseInt(stat.late_count)) / parseInt(stat.total_schedules) * 100) : 0 %>%"></div>
      </div>
    </div>
    <% }) %>

    <% if (quizStats.length > 0) { %>
    <div class="section-card">
      <h3 class="section-title"><i class="fas fa-clipboard-check"></i> Hasil Kuis</h3>
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr><th>Kuis</th><th>Skor</th><th>Nilai</th><th>Tanggal</th></tr>
          </thead>
          <tbody>
            <% quizStats.forEach(q => { %>
            <tr>
              <td><%= q.title %></td>
              <td><%= q.score %> / <%= q.max_score %></td>
              <td>
                <span class="score-badge score-<%= q.max_score > 0 ? (q.score/q.max_score >= 0.7 ? 'good' : 'low') : 'low' %>">
                  <%= q.max_score > 0 ? Math.round(q.score/q.max_score*100) : 0 %>%
                </span>
              </td>
              <td><%= formatDate(q.submitted_at) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <% if (enrollments.length > 0) { %>
    <div class="section-card">
      <h3 class="section-title"><i class="fas fa-id-card"></i> Program yang Diikuti</h3>
      <% enrollments.forEach(e => { %>
      <div class="enrollment-item">
        <div class="enrollment-icon"><i class="fas fa-book"></i></div>
        <div class="enrollment-info">
          <strong><%= e.program_name %></strong>
          <span><%= formatDate(e.start_date) %> - <%= formatDate(e.end_date) %></span>
        </div>
        <span class="badge-status badge-<%= e.status %>"><%= e.status %></span>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
