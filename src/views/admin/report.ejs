<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'admin' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Member Report</h1>
    <p class="sub-banner-desc">Admin hanya melihat report yang diisi tutor.</p>
  </div>

  <div class="container">
    <div class="at-stats">
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--brand-600)"><i class="fas fa-file-lines"></i></span>
        <div><strong><%= stats.total %></strong><small>Total report</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--success)"><i class="fas fa-users"></i></span>
        <div><strong><%= stats.members %></strong><small>Member</small></div>
      </div>
    </div>

    <div class="section-card">
      <form method="GET" action="/admin/report" class="filter-form">
        <select name="tutor_id" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Tutor</option>
          <% tutors.forEach(t => { %><option value="<%= t.id %>" <%= filters.tutorId == t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
        </select>
        <select name="program_id" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Program</option>
          <% programs.forEach(p => { %><option value="<%= p.id %>" <%= filters.programId == p.id ? 'selected' : '' %>><%= p.name %></option><% }) %>
        </select>
        <a href="/admin/report" class="btn btn-outline">Reset</a>
      </form>
    </div>

    <div class="section-card">
      <h3 class="section-title"><i class="fas fa-list"></i> Daftar Report</h3>
      <% if (reports.length === 0) { %>
        <div class="empty-state"><i class="fas fa-file-lines"></i><p>Belum ada report.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table">
            <thead><tr><th>Member</th><th>Periode</th><th>Program</th><th>Tutor</th><th>Update</th><th></th></tr></thead>
            <tbody>
              <% reports.forEach(r => { %>
                <tr>
                  <td><strong><%= r.member_name %></strong><div class="table-subtext"><%= r.package_name || '-' %></div></td>
                  <td><%= formatDate(r.period_start) %></td>
                  <td><%= r.program_name %></td>
                  <td><%= r.tutor_name %></td>
                  <td><%= formatDate(r.updated_at) %></td>
                  <td><a href="/admin/report/<%= r.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i> View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
