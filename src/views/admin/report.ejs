<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'admin' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Member Report</h1>
    <p class="sub-banner-desc">Admin hanya melihat report yang diisi tutor.</p>
  </div>

  <div class="container">
    <div class="at-stats">
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--brand-600)"><i class="fas fa-file-lines"></i></span>
        <div><strong><%= stats.total %></strong><small>Total report</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--success)"><i class="fas fa-users"></i></span>
        <div><strong><%= stats.members %></strong><small>Member</small></div>
      </div>
    </div>

    <div class="section-card">
      <form method="GET" action="/admin/report" class="filter-form">
        <select name="tutor_id" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Tutor</option>
          <% tutors.forEach(t => { %><option value="<%= t.id %>" <%= filters.tutorId == t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
        </select>
        <select name="program_id" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Program</option>
          <% programs.forEach(p => { %><option value="<%= p.id %>" <%= filters.programId == p.id ? 'selected' : '' %>><%= p.name %></option><% }) %>
        </select>
        <select name="period" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Periode</option>
          <% periods.forEach(pr => { %><option value="<%= pr.value %>" <%= filters.period === pr.value ? 'selected' : '' %>><%= pr.label %></option><% }) %>
        </select>
        <a href="/admin/report" class="btn btn-outline">Reset</a>
      </form>
    </div>

    <!-- Diagnostic Test Report (khusus member Luxury) -->
    <div class="section-card" id="diagnostic">
      <h3 class="section-title"><i class="fas fa-file-medical"></i> Diagnostic Test Report <span class="bonus-label">Luxury</span></h3>
      <p class="module-materials-note">Unggah laporan diagnostic test (PDF/gambar) untuk member Luxury. Member bisa mengunduhnya di halaman Report mereka.</p>
      <% if ((luxuryMembers || []).length === 0) { %>
        <div class="empty-state compact"><i class="fas fa-user-slash"></i><p>Belum ada member Luxury aktif.</p></div>
      <% } else { %>
        <form action="/admin/report/diagnostic" method="POST" enctype="multipart/form-data" class="filter-form" style="flex-wrap:wrap;gap:10px">
          <select name="member_id" class="form-input" required>
            <option value="">- Pilih Member Luxury -</option>
            <% luxuryMembers.forEach(m => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
          </select>
          <input type="text" name="title" class="form-input" maxlength="255" placeholder="Judul (opsional), mis. Diagnostic Test Report 1">
          <input type="file" name="report_file" class="form-input" accept=".pdf,image/*" required>
          <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> Unggah</button>
        </form>
      <% } %>

      <% if ((diagnosticReports || []).length > 0) { %>
        <div class="table-wrapper" style="margin-top:14px">
          <table class="data-table">
            <thead><tr><th>Member</th><th>Judul</th><th>Diunggah oleh</th><th>Tanggal</th><th>Aksi</th></tr></thead>
            <tbody>
              <% diagnosticReports.forEach(dr => { %>
                <tr>
                  <td><%= dr.member_name %></td>
                  <td><%= dr.title || 'Diagnostic Test Report' %></td>
                  <td><%= dr.uploader_name || '-' %> <small>(<%= dr.uploader_role %>)</small></td>
                  <td><%= formatDate(dr.created_at) %></td>
                  <td>
                    <div class="row-actions">
                      <a href="<%= dr.file_url %>" class="btn btn-sm btn-outline" target="_blank" rel="noopener"><i class="fas fa-eye"></i> Lihat</a>
                      <form action="/admin/report/diagnostic/<%= dr.id %>/delete" method="POST" onsubmit="return confirm('Hapus laporan ini?')" style="display:inline">
                        <button class="btn btn-sm btn-outline" title="Hapus"><i class="fas fa-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="section-card">
      <h3 class="section-title"><i class="fas fa-list"></i> Daftar Report</h3>
      <% if (reports.length === 0) { %>
        <div class="empty-state"><i class="fas fa-file-lines"></i><p>Belum ada report.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table">
            <thead><tr><th>Member</th><th>Periode</th><th>Program</th><th>Tutor</th><th>Update</th><th></th></tr></thead>
            <tbody>
              <% reports.forEach(r => { %>
                <tr>
                  <td><strong><%= r.member_name %></strong><div class="table-subtext"><%= r.package_name || '-' %></div></td>
                  <td><%= formatDate(r.period_start) %></td>
                  <td><%= r.program_name %></td>
                  <td><%= r.tutor_name %></td>
                  <td><%= formatDate(r.updated_at) %></td>
                  <td><a href="/admin/report/<%= r.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i> View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
