<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'admin' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>

  <div class="sub-banner">
    <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Questionnaire</h1>
    <p class="sub-banner-desc">Buat questionnaire, susun soal, dan pantau respon yang masuk.</p>
  </div>

  <div class="container">
    <div class="at-stats">
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--brand-600)"><i class="fas fa-clipboard-list"></i></span>
        <div><strong><%= stats.total %></strong><small>Questionnaire</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--info)"><i class="fas fa-question-circle"></i></span>
        <div><strong><%= stats.questions %></strong><small>Total soal</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--success)"><i class="fas fa-reply-all"></i></span>
        <div><strong><%= stats.responses %></strong><small>Total respon</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--warning)"><i class="fas fa-users"></i></span>
        <div><strong><%= stats.respondents %></strong><small>Responden</small></div>
      </div>
    </div>

    <details class="section-card qbuilder-create">
      <summary><i class="fas fa-plus-circle"></i> Buat Questionnaire Baru</summary>
      <form method="POST" action="/admin/questionnaire" class="qbuilder-form">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Judul <span class="req">*</span></label>
            <input type="text" name="title" class="form-input" placeholder="mis. Evaluasi Kelas Speaking" required>
          </div>
          <div class="form-group">
            <label class="form-label">Program <span class="req">*</span></label>
            <select name="program_id" class="form-input" required>
              <option value="">- Pilih Program -</option>
              <% programs.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Deskripsi</label>
          <input type="text" name="description" class="form-input" placeholder="Keterangan singkat (opsional)">
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Buat &amp; Tambah Soal</button>
      </form>
    </details>

    <div class="section-card">
      <form method="GET" action="/admin/questionnaire" class="filter-form">
        <select name="program_id" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Program</option>
          <% programs.forEach(p => { %>
            <option value="<%= p.id %>" <%= filters.programId == p.id ? 'selected' : '' %>><%= p.name %></option>
          <% }) %>
        </select>
        <select name="tutor" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Tutor</option>
          <% tutorOptions.forEach(t => { %>
            <option value="<%= t %>" <%= filters.tutor === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
        <select name="period" class="form-input" onchange="this.form.submit()">
          <option value="">Semua Periode</option>
          <% periodOptions.forEach(pr => { %>
            <option value="<%= pr %>" <%= filters.period === pr ? 'selected' : '' %>><%= pr %></option>
          <% }) %>
        </select>
        <a href="/admin/questionnaire" class="btn btn-outline">Reset</a>
      </form>
    </div>

    <div class="section-card">
      <div class="list-meta"><span><i class="fas fa-list"></i> <%= questionnaires.length %> questionnaire</span></div>
      <% if (questionnaires.length === 0) { %>
        <div class="empty-state"><i class="fas fa-clipboard-list"></i><p>Tidak ada questionnaire.</p></div>
      <% } else { %>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr><th>Judul</th><th>Program</th><th>Dibuat oleh</th><th>Soal</th><th>Respon</th><th></th></tr>
            </thead>
            <tbody>
              <% questionnaires.forEach(q => { %>
              <tr>
                <td><strong><%= q.title %></strong><div class="table-subtext"><%= q.description || '-' %></div></td>
                <td><%= q.program_name %></td>
                <td><%= q.creator_name || '-' %></td>
                <td><%= q.question_count %></td>
                <td><%= q.response_count %></td>
                <td><a href="/admin/questionnaire/<%= q.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i> View</a></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
