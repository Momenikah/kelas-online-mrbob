<%- include('../partials/head') %>
<%- include('../partials/navbar', { activeNav: 'admin' }) %>

<div class="page-wrapper">
  <%- include('../partials/flash') %>
  <div class="sub-banner">
    <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i></a>
    <h1>Kelola Program</h1>
    <button class="btn btn-light" onclick="openCreateProgram()">
      <i class="fas fa-plus"></i> Tambah Program
    </button>
  </div>

  <div class="container">
    <!-- Summary stats -->
    <div class="at-stats">
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--brand-600)"><i class="fas fa-graduation-cap"></i></span>
        <div><strong><%= stats.total %></strong><small>Total program</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--success)"><i class="fas fa-circle-check"></i></span>
        <div><strong><%= stats.active %></strong><small>Aktif</small></div>
      </div>
      <div class="at-stat">
        <span class="at-stat-icon" style="--c:var(--info)"><i class="fas fa-id-card"></i></span>
        <div><strong><%= stats.active_enrollments %></strong><small>Enrollment aktif</small></div>
      </div>
    </div>

    <div class="section-card">
      <form method="GET" action="/admin/programs" class="filter-form">
        <input type="text" name="search" class="form-input" placeholder="Cari nama program..." value="<%= filters.search || '' %>">
        <select name="status" class="form-input">
          <option value="">Semua Status</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Aktif</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Non-aktif</option>
        </select>
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Cari</button>
        <a href="/admin/programs" class="btn btn-outline">Reset</a>
      </form>
    </div>

    <% if (programs.length === 0) { %>
      <div class="section-card"><div class="empty-state"><i class="fas fa-graduation-cap"></i><p>Tidak ada program yang cocok.</p></div></div>
    <% } else { %>
    <div class="program-grid">
      <% programs.forEach(p => { %>
      <div class="program-card <%= p.is_active ? '' : 'is-off' %>">
        <div class="program-card-header"><i class="fas fa-graduation-cap"></i></div>
        <h4 class="program-name"><%= p.name %></h4>
        <p class="program-desc"><%= p.description || 'Tanpa deskripsi.' %></p>
        <div class="program-detail">
          <span><i class="fas fa-clock"></i> <%= p.duration_months %> Bulan</span>
          <span class="program-price"><%= formatCurrency(p.price) %></span>
        </div>
        <div class="program-meta">
          <span><i class="fas fa-id-card"></i> <%= p.active_enrollments %> enrollment aktif</span>
          <span><i class="fas fa-calendar-day"></i> <%= p.schedule_count %> jadwal</span>
        </div>
        <div class="program-foot">
          <span class="badge-pill <%= p.is_active ? 'badge-completed' : 'badge-cancelled' %>">
            <%= p.is_active ? 'Aktif' : 'Non-aktif' %>
          </span>
          <div class="row-actions">
            <button type="button" class="btn-icon btn-edit-icon" title="Edit"
              data-edit-program
              data-id="<%= p.id %>"
              data-name="<%= p.name %>"
              data-description="<%= p.description || '' %>"
              data-duration="<%= p.duration_months %>"
              data-price="<%= p.price %>"
              data-active="<%= p.is_active %>">
              <i class="fas fa-pen"></i>
            </button>
            <form action="/admin/programs/<%= p.id %>/toggle-status" method="POST" style="display:inline">
              <button class="btn-icon" title="<%= p.is_active ? 'Nonaktifkan' : 'Aktifkan' %>"><i class="fas fa-power-off"></i></button>
            </form>
            <form action="/admin/programs/<%= p.id %>/delete" method="POST" style="display:inline"
                  data-confirm="Hapus program &quot;<%= p.name %>&quot;? Tindakan ini permanen.">
              <button class="btn-icon btn-danger-icon" title="Hapus"><i class="fas fa-trash"></i></button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Create / Edit modal (shared) -->
  <div class="modal" id="programModal" style="display:none">
    <div class="modal-overlay" onclick="toggleModal('programModal')"></div>
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="programModalTitle">Tambah Program</h3>
        <button class="modal-close" onclick="toggleModal('programModal')"><i class="fas fa-times"></i></button>
      </div>
      <form id="programForm" action="/admin/programs" method="POST" class="modal-form">
        <div class="form-group">
          <label class="form-label">Nama Program</label>
          <input type="text" name="name" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">Deskripsi</label>
          <textarea name="description" class="form-textarea" rows="3"></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Durasi (bulan)</label>
            <input type="number" name="duration_months" class="form-input" min="1" value="3" required>
          </div>
          <div class="form-group">
            <label class="form-label">Harga (Rp)</label>
            <input type="number" name="price" class="form-input" min="0" value="0" required>
          </div>
        </div>
        <div class="form-group" id="programStatusGroup" hidden>
          <label class="check-inline"><input type="checkbox" name="is_active"> Program aktif</label>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-outline" onclick="toggleModal('programModal')">Batal</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <span id="programSubmitLabel">Simpan</span></button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function () {
  var form = document.getElementById('programForm');
  var title = document.getElementById('programModalTitle');
  var submitLabel = document.getElementById('programSubmitLabel');
  var statusGroup = document.getElementById('programStatusGroup');

  window.openCreateProgram = function () {
    form.action = '/admin/programs';
    form.reset();
    form.querySelector('[name="duration_months"]').value = 3;
    form.querySelector('[name="price"]').value = 0;
    statusGroup.hidden = true; // new programs default to active
    title.textContent = 'Tambah Program';
    submitLabel.textContent = 'Simpan';
    toggleModal('programModal');
  };

  document.querySelectorAll('[data-edit-program]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var d = btn.dataset;
      form.action = '/admin/programs/' + d.id;
      form.querySelector('[name="name"]').value = d.name || '';
      form.querySelector('[name="description"]').value = d.description || '';
      form.querySelector('[name="duration_months"]').value = d.duration || 1;
      form.querySelector('[name="price"]').value = d.price || 0;
      form.querySelector('[name="is_active"]').checked = d.active === 'true';
      statusGroup.hidden = false;
      title.textContent = 'Edit Program';
      submitLabel.textContent = 'Simpan Perubahan';
      toggleModal('programModal');
    });
  });
})();
</script>

<%- include('../partials/footer') %>
